<office:meta><dc:title>The wrath, cited</dc:title><meta:initial-creator>Robert Emil Berge</meta:initial-creator><meta:user-defined meta:name="ZOTERO_BREF_Qw3Er5Ty7Ui9_1" meta:value-type="string">ZOTERO_ITEM CSL_CITATION {"citationID":"wX3kq9Lm","properties":{"formattedCitation":"(Nagy 1979, 73)","plainCitation":"(Nagy 1979, 73)","noteIndex":0},"citationItems":[{"id":12,"uris":["http://zotero.org/users/1234567/items/ABCD2345"],"itemData":{"id":12,</meta:user-defined><meta:user-defined meta:name="ZOTERO_BREF_Qw3Er5Ty7Ui9_2" meta:value-type="string">"type":"book","abstract":"Despite widespread interest in the Greek hero as a cult figure, little was written about the relationship between the cult practices and the portrayals of the hero in poetry. Despite widespread interest in the Greek hero as a cul</meta:user-defined><meta:user-defined meta:name="ZOTERO_BREF_Qw3Er5Ty7Ui9_3" meta:value-type="string">t figure, little was written about the relationship between the cult practices and the portrayals of the hero in poetry. Despite widespread interest in the Greek hero as a cult figure, little was written about the relationship between the cult practices a</meta:user-defined><meta:user-defined meta:name="ZOTERO_BREF_Qw3Er5Ty7Ui9_4" meta:value-type="string">nd the portrayals of the hero in poetry. Despite widespread interest in the Greek hero as a cult figure, little was written about the relationship between the cult practices and the portrayals of the hero in poetry. ","event-place":"Baltimore","ISBN":"978</meta:user-defined><meta:user-defined meta:name="ZOTERO_BREF_Qw3Er5Ty7Ui9_5" meta:value-type="string">-0-8018-2200-6","note":"A note of the one who keeps the library, which says nothing of which work it is.","publisher":"Johns Hopkins University Press","publisher-place":"Baltimore","title":"The Best of the Achaeans: Concepts of the Hero in Archaic Greek P</meta:user-defined><meta:user-defined meta:name="ZOTERO_BREF_Qw3Er5Ty7Ui9_6" meta:value-type="string">oetry","author"