meta:user-defined><meta:user-defined meta:name="ZOTERO_BREF_Pl0Ok9Ij8Uh7_5" meta:value-type="string">o in poetry. ","event-place":"Baltimore","ISBN":"978-0-8018-2200-6","note":"A note of the one who keeps the library, which says nothing of which work it is.","publisher":"Johns Hopkins University Press","publisher-place":"Baltimore","title":"The Best of t</meta:user-defined><meta:user-defined meta:name="ZOTERO_BREF_Pl0Ok9Ij8Uh7_6" meta:value-type="string">he Achaeans: Concepts of the Hero in Archaic Greek Poetry","author":[{"family":"Nagy","given":"Gregory"}],"issued":{"date-parts":[["1979"]]}},"locator":"73","label":"page"}],"schema":"https://github.com/citation-style-language/schema/raw/master/csl-citati</meta:user-defined><meta:user-defined meta:name="ZOTERO_BREF_Pl0Ok9Ij8Uh7_7" meta:value-type="string">on.json"}</meta:user-defined></office:meta>
