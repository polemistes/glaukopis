# What the core says of the notebook, in English.
# See locales/README.md.

core-notebook-reading = reading the notebook
core-notebook-picture-too-large = a picture handed to the notebook is larger than { $most } MB
# Of a note written in a window of its own (record 0109).
core-notebook-note-empty = an empty note is not sent
core-notebook-note-too-large = the text of the note is larger than { $most } MB
core-notebook-file-too-large = { $name } is larger than { $most } MB
# What was handed over by another app on a phone held neither words nor files; said after other words, so it begins with a small letter.
core-notebook-shared-empty = nothing was shared
# A file another app handed over could not be read from it; $name is what the other app calls the file.
core-notebook-shared-unread = { $name } could not be read
