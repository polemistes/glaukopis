# The synchronization between the writer's computers, in English: its
# section in the settings, and what is told when a project was written in
# on two computers apart. See locales/README.md.

sync-title = Synchronization
sync-about = Your projects, your notebook and your settings, the same on each of your computers, through a server.

## Before it is on.

sync-server = Server
sync-computer-name = Name of this computer
# The choice between the two ways of beginning, as a screen reader names it.
sync-how = How this computer begins
sync-how-start = Start here
sync-how-join = Join with a code
sync-password = Password of the server
sync-code = Code
sync-start = Start synchronizing
sync-starting = Starting…
sync-join = Join
sync-joining = Joining…
sync-unreachable = The server could not be reached.

## While it is on.

sync-working = Synchronizing…
# $when is how long ago, as "just now", "3 minutes ago" or "12 March".
sync-last = Last synchronized { $when }
sync-never = Not synchronized yet
sync-offline = The server cannot be reached. What is written here is kept, and sent when it can be.
sync-refused = Synchronization has stopped on this computer
sync-now = Synchronize now
sync-computers = Computers
sync-this-computer = { $name } (this computer)
# $when is how long ago, as "just now", "3 minutes ago" or "12 March".
sync-seen = Last seen { $when }
sync-computers-unread = The server could not be asked which computers there are.
sync-add = Add a computer…
# $join is the name of the choice the other computer makes, shown in italics; $until is a time of day.
sync-code-hint = Enter the code on the other computer, with { $join } under Synchronization in its settings. It can be used once, until { $until }.
sync-code-failed = No code could be made.
sync-rename-title = Rename the computer
sync-remove-title = Remove “{ $name }”?
sync-remove-message = It is synchronized no more. What is on it stays there.
# $why is what went wrong, a sentence of its own.
sync-remove-failed = “{ $name }” could not be removed. { $why }
sync-stop = Stop synchronizing on this computer
sync-stop-title = Stop synchronizing on this computer?
sync-stop-message = What is on this computer stays here as it is. What is written on your other computers no longer comes here, and what is written here no longer goes to them.
sync-stop-message-alone = What is on this computer stays here as it is. It is the only computer that is synchronized, so nothing is left on the server.
sync-stop-confirm = Stop synchronizing
sync-stop-failed = The synchronization could not be stopped

## Written apart.

sync-apart = “{ $name }” was written in on two computers while they were apart.
sync-apart-show = Show the changes
sync-apart-no-history = Its history is not kept, so the changes cannot be shown. The project as it was before is among its earlier versions.
sync-apart-earlier = Earlier versions
# The moment the review of such a project goes from, as the review names it: Since “the computers met”.
sync-apart-moment = the computers met
