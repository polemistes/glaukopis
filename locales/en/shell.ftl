# The frame of the application: the places in the row at the top of the window.

shell-projects = Projects
shell-library = Library
shell-notebook = Notebook
shell-settings = Settings

# Closing the window: what is said while saving is waited for, and when it fails.
closing-still-saving = Still saving before the window closes. Close it again to close without waiting.
closing-not-saved = The last changes could not be saved, and the window was left open. Close it again to close all the same

# Said in place of the window where the system's web view, with which the window is drawn, lacks what Glaukopis needs.
shell-web-view-too-old-title = This system is too old for Glaukopis
shell-web-view-too-old = Glaukopis draws its window with the web view of the system, and the one here is older than it needs. On a Mac it needs Safari 16.4 or newer: update macOS with Software Update.
