# The language of an element: the part of the document settings that holds
# it, and the menu item that opens the settings there (ADR 0020, 0038).

languages-menu = Languages…
# What follows from the language of a map: the words its document prints in
# words of its own, the dictionary of its spelling, the quotation marks of a mention.
languages-map-hint = For the element and everything under it that says nothing itself. Decides the words its document prints in words of its own, such as “Notes” and “Figure”; the dictionary its spelling is checked by; and the quotation marks a mention stands in.
# A map that was given no language is printed in English.
languages-map-none = Not stated
# Names of languages the system may have no name for, by their tags.
language-name-hbo = Biblical Hebrew
language-name-xcl = Classical Armenian
languages-project-hint = What the project is written in, for everyone it is shared with: every element takes it that is given no other. A document brought in keeps the language of the document.
# Where the project chooses none, the settings' language of new texts holds; it is named.
languages-project-settings = As in the settings ({ $language })
