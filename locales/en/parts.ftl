# The kinds of elements that make a document, which come with the
# application (ADR 0038): what each is called in the kind menu and on the
# label of an element. The core has the same kinds, with their looks.

parts-group-front = Front matter
parts-group-back = Back matter
parts-group-cover = Cover
parts-more = More…

# The bases.
parts-front-section = Front section
parts-back-section = Back section
parts-own-page = Page of its own
parts-cover = Cover

# Front matter.
parts-abstract = Abstract
parts-dedication = Dedication
parts-epigraph = Epigraph
parts-copyright = Copyright page
parts-foreword = Foreword
parts-preface = Preface
parts-cast = Cast
parts-setting = Setting
parts-standfirst = Standfirst

# Back matter.
parts-acknowledgements = Acknowledgements
parts-appendix = Appendix
parts-afterword = Afterword
parts-glossary = Glossary
parts-about-the-author = About the author
parts-signature = Signature

# The cover.
parts-blurb = Blurb

# On the label of a second element of a kind a document has one of.
parts-doubled = Not printed: another element of this kind comes first among its siblings.

## Where a kind puts an element in the document, where not where it stands.

parts-placed-front = Printed at the front, before the rest of its level
parts-placed-back = Printed at the back, after the rest of its level
parts-placed-cover = Printed on the cover only
parts-placed-none = Not printed in the document
parts-placed-front-short = printed at the front
parts-placed-back-short = printed at the back
parts-placed-cover-short = on the cover only
parts-placed-none-short = not printed
