# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Comments
comments-between = Between the map and the comments
comments-comment-on = Comment…
comments-comment = Comment
comments-write = Write a comment. Enter sends it; Shift+Enter is a new line.
# $name: the element the comment is on.
comments-on = On “{ $name }”
comments-answer = Answer…
comments-which = Which comments are shown
comments-open = { $count ->
    [0] Open
   *[other] Open ({ $count })
}
comments-settled = { $count ->
    [0] Settled
   *[other] Settled ({ $count })
}
comments-all = All
comments-none = No comments yet
comments-none-detail = Select some text and press Ctrl+Alt+C, or choose Comment… from an element’s menu. A comment is never part of the text.
comments-none-of-these = None of these.
comments-settle = Settle the thread
comments-reopen = Open the thread again
comments-edit = Change
comments-edited = changed
comments-someone = Someone
comments-note-deleted = The note was deleted
# On an element in the diagram, and in the margin of the text.
comments-mark = { $count ->
    [one] One open comment
   *[other] { $count } open comments
}
comments-show-cards = Show the comments beside their elements
