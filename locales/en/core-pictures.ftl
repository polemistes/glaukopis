# What the core says of the store of pictures, in English.
# See locales/README.md.

core-pictures-not-a-picture = the file is not a picture of a kind that can be used: PNG, JPEG, SVG, GIF, WebP, TIFF or BMP
core-pictures-unreadable = the picture could not be read: { $error }
core-pictures-not-a-name = this does not name a picture
core-pictures-not-as-asked = what arrived is not the picture that was asked for
core-pictures-needs-name = a picture must be called something
core-pictures-too-large = the picture is larger than { $most } MB, which is the most a picture may be
core-pictures-not-whole = the picture did not arrive whole
# Shown after "not found: ".
core-pictures-the-picture = the picture
# What a picture that came without a name is called, before the ending of
# its file: "picture.png".
core-pictures-unnamed = picture
