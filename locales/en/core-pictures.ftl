# What the core says of the store of pictures, in English.
# See locales/README.md.

core-pictures-not-a-picture = the file is not an image of a kind that can be used: PNG, JPEG, SVG, GIF, WebP, TIFF or BMP
core-pictures-unreadable = the image could not be read: { $error }
core-pictures-not-as-asked = what arrived is not the image that was asked for
core-pictures-too-large = the image is larger than { $most } MB, which is the most an image may be
core-pictures-not-whole = the image did not arrive whole
# Shown after "not found: ".
core-pictures-the-picture = the image
# What a picture that came without a name is called, before the ending of
# its file: "picture.png".
core-pictures-unnamed = image

# A simple image editor (docs/plans/a-simple-image-editor.md).
# Put before the ending of a copy's name: "plate (edited).jpg", "plate (edited 2).jpg".
core-pictures-edited = edited
# Likewise: "plate (smaller).jpg".
core-pictures-smaller = smaller
core-pictures-not-editable = a drawing has no pixels to edit
core-pictures-nothing-changed = nothing was changed
