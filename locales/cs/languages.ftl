# The languages of a map and of a project: the dialog opened from the menu
# of a map (ADR 0020).

languages-menu = Jazyky…
languages-dialog = Jazyky
languages-dialog-subtitle = Jazyk této mapy a map budoucích
languages-map = Jazyk této mapy
# What follows from the language of a map: the words its document prints in
# words of its own, the dictionary of its spelling, the quotation marks of a mention.
languages-map-hint = Rozhoduje o slovech, která její dokument tiskne vlastními slovy, jako „Poznámky“ a „Obrázek“; o slovníku, podle něhož se kontroluje pravopis; a o uvozovkách, v nichž stojí zmínka.
# A map that was given no language is printed in English.
languages-map-none = Neuvedeno (angličtina)
languages-project = Jazyk nových map v tomto projektu
languages-project-hint = V čem se píše mapa vytvořená v tomto projektu, pro všechny, s nimiž je sdílen. Mapa vytvořená z dokumentu si ponechá jazyk dokumentu. Každé mapě lze výše dát jiný.
# Where the project chooses none, the settings' language of new texts holds; it is named.
languages-project-settings = Jako v nastavení ({ $language })
