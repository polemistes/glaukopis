# What the core says of spelling, in English. See locales/README.md.

# $name is the name of the dictionary's files: nb_NO. $message says why.
spelling-unreadable = Slovník { $name } nelze přečíst: { $message }
spelling-encoding = Slovník { $name } je zapsán v kódování, které nelze přečíst.
# Stands after "not found:". $language is the language of a map: nb, en-GB.
spelling-dictionary-for = slovník pro „{ $language }“
spelling-not-a-word = „{ $word }“ nelze přidat k vašim slovům.
spelling-not-a-language = Vlastní slova nelze uchovávat pro „{ $language }“.
