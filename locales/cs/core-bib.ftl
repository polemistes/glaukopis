# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = @string bez názvu
core-bib-expected-found = očekáváno `{ $expected }`, nalezeno `{ $found }`
core-bib-expected-end = očekáváno `{ $expected }`, ale soubor skončil
core-bib-expected-brace = po `@{ $kind }` nenásleduje `{"{"}` ani `(`
core-bib-comment-not-closed = komentář, který není nikde ukončen
core-bib-entry-not-closed = záznam `{ $key }` není nikde ukončen
core-bib-expected-field = v `{ $key }`: očekáván název pole, nalezeno `{ $found }`
core-bib-field-without-value = v `{ $key }`: pole `{ $field }` nemá hodnotu
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = v `{ $key }`, pole `{ $field }`: { $message }
core-bib-brace-not-closed = závorka, která není nikde uzavřena
core-bib-quote-not-closed = uvozovka, která není nikde uzavřena
core-bib-expected-value = očekávána hodnota, nalezeno `{ $found }`
core-bib-abbreviation = zkratka `{ $name }` není definována
core-bib-ended-in-value = soubor skončil uprostřed hodnoty
