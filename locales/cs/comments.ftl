}
comments-show-cards = Zobrazit každý komentář pod jeho prvkem
comments-mark-hint = { $count ->
    [one] Jeden otevřený komentář: stisknutím jej zobrazíte pod prvkem, nebo skryjete
    [few] { $count } otevřené komentáře: stisknutím je zobrazíte pod prvkem, nebo skryjete
