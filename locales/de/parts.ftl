# The kinds of elements that make a document, which come with the
# application (ADR 0038): what each is called in the kind menu and on the
# label of an element. The core has the same kinds, with their looks.

parts-group-front = Vorspann
parts-group-back = Nachspann
parts-group-cover = Umschlag
parts-more = Mehr…

# The bases.
parts-front-section = Abschnitt im Vorspann
parts-back-section = Abschnitt im Nachspann
parts-own-page = Eigene Seite
parts-cover = Umschlag

# Front matter.
parts-abstract = Zusammenfassung
parts-dedication = Widmung
parts-epigraph = Motto
parts-copyright = Impressum
parts-foreword = Geleitwort
parts-preface = Vorwort
parts-cast = Personen
parts-setting = Schauplatz
parts-standfirst = Lead

# Back matter.
parts-acknowledgements = Danksagung
parts-appendix = Anhang
parts-afterword = Nachwort
parts-glossary = Glossar
parts-about-the-author = Über den Autor
parts-signature = Unterschrift

# The cover.
parts-blurb = Klappentext

# On the label of a second element of a kind a document has one of.
parts-doubled = Nicht gedruckt: ein anderes Element dieser Art kommt auf derselben Ebene zuerst.

## Where a kind puts an element in the document, where not where it stands.

parts-placed-front = Vorn gedruckt, vor dem Rest seiner Ebene
parts-placed-back = Hinten gedruckt, nach dem Rest seiner Ebene
parts-placed-cover = Nur auf dem Umschlag gedruckt
parts-placed-none = Nicht im Dokument gedruckt
parts-placed-front-short = vorn gedruckt
parts-placed-back-short = hinten gedruckt
parts-placed-cover-short = nur auf dem Umschlag
parts-placed-none-short = nicht gedruckt
