# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = ein @string ohne Namen
core-bib-expected-found = `{ $expected }` erwartet, aber `{ $found }` gefunden
core-bib-expected-end = `{ $expected }` erwartet, aber die Datei endete
core-bib-expected-brace = auf `@{ $kind }` folgt weder `{"{"}` noch `(`
core-bib-comment-not-closed = ein Kommentar, der nie geschlossen wird
core-bib-entry-not-closed = der Eintrag `{ $key }` wird nie geschlossen
core-bib-expected-field = in `{ $key }`: ein Feldname erwartet, aber `{ $found }` gefunden
core-bib-field-without-value = in `{ $key }`: das Feld `{ $field }` hat keinen Wert
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = in `{ $key }`, Feld `{ $field }`: { $message }
core-bib-brace-not-closed = eine Klammer, die nie geschlossen wird
core-bib-quote-not-closed = ein Anführungszeichen, das nie geschlossen wird
core-bib-expected-value = ein Wert erwartet, aber `{ $found }` gefunden
core-bib-abbreviation = die Abkürzung `{ $name }` ist nicht definiert
core-bib-ended-in-value = die Datei endete mitten in einem Wert
