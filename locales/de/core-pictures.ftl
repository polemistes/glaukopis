# What the core says of the store of pictures, in English.
# See locales/README.md.

core-pictures-not-a-picture = die Datei ist kein Bild von einer Art, die verwendet werden kann: PNG, JPEG, SVG, GIF, WebP, TIFF oder BMP
core-pictures-unreadable = das Bild konnte nicht gelesen werden: { $error }
core-pictures-not-a-name = das nennt kein Bild
core-pictures-not-as-asked = was ankam, ist nicht das Bild, das verlangt wurde
core-pictures-needs-name = ein Bild muss einen Namen haben
core-pictures-too-large = das Bild ist größer als { $most } MB, mehr darf ein Bild nicht haben
core-pictures-not-whole = das Bild ist nicht vollständig angekommen
# Shown after "not found: ".
core-pictures-the-picture = das Bild
# What a picture that came without a name is called, before the ending of
# its file: "picture.png".
core-pictures-unnamed = Bild
