# What the core says of the notebook, in English.
# See locales/README.md.

core-notebook-reading = Lesen des Notizbuchs
core-notebook-picture-too-large = ein Bild, das dem Notizbuch übergeben wurde, ist größer als { $most } MB
# Of a note written in a window of its own (record 0109).
core-notebook-note-empty = eine leere Notiz wird nicht gesendet
core-notebook-note-too-large = der Text der Notiz ist größer als { $most } MB
core-notebook-file-too-large = { $name } ist größer als { $most } MB
# What was handed over by another app on a phone held neither words nor files; said after other words, so it begins with a small letter.
core-notebook-shared-empty = es wurde nichts geteilt
# A file another app handed over could not be read from it; $name is what the other app calls the file.
core-notebook-shared-unread = { $name } konnte nicht gelesen werden
