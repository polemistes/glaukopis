spelling-settings = Rechtschreibung
spelling-settings-about = Die Rechtschreibprüfung verwendet Wörterbücher von Hunspell. Wörterbücher, die Sie hier importieren, werden statt derer verwendet, die Sie vielleicht in Ihrem System installiert haben.
spelling-check = Rechtschreibung beim Schreiben prüfen
spelling-on = Ein
spelling-off-short = Aus
spelling-dictionaries = Sprachen der Wörterbücher
spelling-dictionaries-none = Noch keine: importieren Sie unten eines, oder installieren Sie eines mit der Paketverwaltung Ihres Systems.
spelling-source-application = Kommt mit Glaukopis
spelling-source-imported = Importiert
spelling-source-system = System
spelling-source-own = Von Ihnen dort abgelegt
spelling-own-words-none = Sie haben keine Wörter hinzugefügt.
spelling-manage-words = Den Wörterbüchern hinzugefügte Wörter verwalten
spelling-manage-words-title = Den Wörterbüchern hinzugefügte Wörter
spelling-words-language-label = Sprache
