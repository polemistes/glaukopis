# The page of the phone, in English: the few words that are its own. The
# rest are those of the notebook, the settings, the synchronization and the
# editor. See locales/README.md.

# The arrow at the head of a note and of the settings.
phone-back = Zurück
# The button at the head of a note that opens what more can be done with it.
phone-more = Mehr
# The line over the notes: what was written here has not reached the server, which cannot be reached now.
phone-waiting = Hier aufbewahrt und gesendet, sobald der Server erreicht wird
# The line over the notes: the synchronization says something is wrong; pressed, it opens the settings, which say what.
phone-problem = Mit der Synchronisierung stimmt etwas nicht
# The button of the row over the keyboard that opens the phone's camera, and puts the photograph taken into the note.
phone-photograph = Foto aufnehmen
# The button of the row over the keyboard that opens the system's picker, and puts the pictures and files chosen into the note.
phone-picture-or-file = Bild oder Datei
# Said under the heading that some files could not be taken in, of a file chosen that is larger than a note takes; $most is a number of megabytes.
phone-file-too-large = { $name } ist größer als { $most } MB
