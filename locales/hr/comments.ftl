# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Komentari
comments-between = Između mape i komentara
comments-comment-on = Komentiraj…
comments-comment = Komentiraj
comments-write = Napišite komentar. Enter ga šalje; Shift+Enter je novi redak.
# $name: the element the comment is on.
comments-on = Uz „{ $name }”
comments-answer = Odgovori…
comments-which = Koji se komentari prikazuju
comments-open = { $count ->
    [0] Otvoreni
   *[other] Otvoreni ({ $count })
}
comments-settled = { $count ->
    [0] Riješeni
   *[other] Riješeni ({ $count })
}
comments-all = Svi
comments-none = Još nema komentara
comments-none-detail = Odaberite tekst i pritisnite Ctrl+Alt+C, ili odaberite Komentiraj… u izborniku elementa. Komentar nikad nije dio teksta.
comments-none-of-these = Nijedan od ovih.
comments-settle = Riješi nit
comments-reopen = Ponovno otvori nit
comments-edit = Izmijeni
comments-edited = izmijenjeno
comments-someone = Netko
comments-note-deleted = Bilješka je izbrisana
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Pritisnite za odlazak na element; pritisnite dvaput za pisanje u njemu
comments-mark = { $count ->
    [1] Jedan otvoren komentar
    [one] { $count } otvoren komentar
    [few] { $count } otvorena komentara
   *[other] { $count } otvorenih komentara
}
comments-show-cards = Prikaži svaki komentar ispod njegova elementa
comments-mark-hint = { $count ->
    [1] Jedan otvoren komentar: pritisnite da se prikaže ispod elementa, ili sakrije
    [one] { $count } otvoren komentar: pritisnite da se prikaže ispod elementa, ili sakrije
    [few] { $count } otvorena komentara: pritisnite da se prikažu ispod elementa, ili sakriju
   *[other] { $count } otvorenih komentara: pritisnite da se prikažu ispod elementa, ili sakriju
}
