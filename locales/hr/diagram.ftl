# A map as a diagram: the elements on a canvas, their branches and associations.

diagram-map = Mapa
diagram-idea = Naziv
diagram-new-loose = Novi slobodni element ovdje
diagram-new-loose-hint = Misao koja još nema svoje mjesto
diagram-show-all = Prikaži cijelu mapu
diagram-tidy = Uredi cijelu mapu
diagram-tidy-hint = Svaki se element vraća na svoje automatsko mjesto
# The keys are shown as keys, where the variables stand.
diagram-hint-empty = { $tab } dodaje element ispod odabranoga · { $enter } dodaje jedan pokraj njega · dvoklik za pisanje
diagram-hint-linking = Kliknite element s kojim ga želite povezati, ili dođite do njega strelicama i pritisnite { $enter } · { $esc } za odustajanje
diagram-show-under = Prikaži što je ispod njega
diagram-hide-under = Sakrij što je ispod njega
diagram-link-handle = Povucite do drugog elementa da ih povežete

## The view

diagram-view = Prikaz
diagram-zoom-out = Umanji
diagram-zoom-in = Uvećaj
diagram-actual-size = Stvarna veličina
# How large the map is shown, in hundredths of its size.
diagram-zoom = { $percent } %

## Copying and pasting elements.

diagram-copied = { $count ->
    [1] Jedan element kopiran, sa svime ispod njega
    [one] { $count } element kopiran, sa svime ispod njega
    [few] { $count } elementa kopirana, sa svime ispod njih
   *[other] { $count } elemenata kopirano, sa svime ispod njih
}
diagram-nothing-copied = Još ništa nije kopirano
diagram-pasted-elsewhere = Kopirano je iz drugog projekta i ne može se zalijepiti ovdje
