# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = @string bez naziva
core-bib-expected-found = očekivano `{ $expected }`, a nađeno `{ $found }`
core-bib-expected-end = očekivano `{ $expected }`, a datoteka je završila
core-bib-expected-brace = iza `@{ $kind }` ne slijedi ni `{"{"}` ni `(`
core-bib-comment-not-closed = komentar koji nije zatvoren
core-bib-entry-not-closed = unos `{ $key }` nije zatvoren
core-bib-expected-field = u `{ $key }`: očekivan naziv polja, a nađeno `{ $found }`
core-bib-field-without-value = u `{ $key }`: polje `{ $field }` nema vrijednosti
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = u `{ $key }`, polje `{ $field }`: { $message }
core-bib-brace-not-closed = vitičasta zagrada koja nije zatvorena
core-bib-quote-not-closed = navodnik koji nije zatvoren
core-bib-expected-value = očekivana vrijednost, a nađeno `{ $found }`
core-bib-abbreviation = kratica `{ $name }` nije definirana
core-bib-ended-in-value = datoteka je završila usred vrijednosti
