## How long ago something was: "Changed { $ago }".

time-just-now = upravo sad
time-minutes-ago = { $count ->
    [1] prije jedne minute
    [one] prije { $count } minutu
    [few] prije { $count } minute
   *[other] prije { $count } minuta
}
time-hours-ago = { $count ->
    [1] prije sat vremena
    [one] prije { $count } sat
    [few] prije { $count } sata
   *[other] prije { $count } sati
}
time-yesterday = jučer
time-days-ago = { $count ->
    [one] prije { $count } dan
    [few] prije { $count } dana
   *[other] prije { $count } dana
}
