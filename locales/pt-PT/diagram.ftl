# A map as a diagram: the elements on a canvas, their branches and associations.

diagram-map = Mapa
diagram-idea = Nome
diagram-show-all = Mostrar o mapa inteiro
diagram-tidy = Arrumar o mapa inteiro
# The keys are shown as keys, where the variables stand.
diagram-hint-linking = Clique no elemento a associar, ou vá até ele com as setas e prima { $enter } · { $esc } para desistir
diagram-link-handle = Arraste até outro elemento para os associar

## The view

diagram-view = Vista
diagram-zoom-out = Reduzir
diagram-zoom-in = Ampliar
diagram-actual-size = Tamanho real
# How large the map is shown, in hundredths of its size.
diagram-zoom = { $percent }%

## Copying and pasting elements.

diagram-copied = { $count ->
    [one] Um elemento copiado, com tudo o que está sob ele
    [many] { $count } elementos copiados, com tudo o que está sob eles
   *[other] { $count } elementos copiados, com tudo o que está sob eles
}
diagram-nothing-copied = Ainda nada foi copiado
diagram-pasted-elsewhere = O que foi copiado é de outro projeto, e não pode ser colado aqui
