# What the core says of spelling, in English. See locales/README.md.

# $name is the name of the dictionary's files: nb_NO. $message says why.
spelling-unreadable = Não foi possível ler o dicionário { $name }: { $message }
spelling-encoding = O dicionário { $name } está escrito numa codificação que não se consegue ler.
# Stands after "not found:". $language is the language of a map: nb, en-GB.
spelling-dictionary-for = um dicionário para «{ $language }»
spelling-not-a-word = «{ $word }» não pode ser acrescentada às palavras próprias.
spelling-not-a-language = Não se podem guardar palavras próprias para «{ $language }».
