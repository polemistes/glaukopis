# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Comentários
comments-between = Entre o mapa e os comentários
comments-comment-on = Comentar…
comments-comment = Comentar
comments-write = Escreva um comentário. Enter envia-o; Shift+Enter muda de linha.
# $name: the element the comment is on.
comments-on = Em «{ $name }»
comments-answer = Responder…
comments-which = Que comentários se mostram
comments-open = { $count ->
    [0] Abertos
   *[other] Abertos ({ $count })
}
comments-settled = { $count ->
    [0] Resolvidos
   *[other] Resolvidos ({ $count })
}
comments-all = Todos
comments-none = Ainda não há comentários
comments-none-detail = Selecione algum texto e prima Ctrl+Alt+C, ou escolha Comentar… no menu de um elemento. Um comentário nunca faz parte do texto.
comments-none-of-these = Nenhum destes.
comments-settle = Dar o fio por resolvido
comments-reopen = Reabrir o fio
comments-edit = Alterar
comments-edited = alterado
comments-someone = Alguém
comments-note-deleted = A nota foi eliminada
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Clique para ir ao elemento; duas vezes para escrever nele
comments-mark = { $count ->
    [one] Um comentário aberto
    [many] { $count } comentários abertos
   *[other] { $count } comentários abertos
}
comments-show-cards = Mostrar cada comentário sob o seu elemento
comments-mark-hint = { $count ->
    [one] Um comentário aberto: clique para o mostrar sob o elemento, ou para o ocultar
    [many] { $count } comentários abertos: clique para os mostrar sob o elemento, ou para os ocultar
   *[other] { $count } comentários abertos: clique para os mostrar sob o elemento, ou para os ocultar
}
