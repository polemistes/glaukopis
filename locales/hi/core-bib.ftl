# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = एक @string जिसका कोई नाम नहीं
core-bib-expected-found = `{ $expected }` की अपेक्षा थी, पर `{ $found }` मिला
core-bib-expected-end = `{ $expected }` की अपेक्षा थी, पर फ़ाइल ख़त्म हो गई
core-bib-expected-brace = `@{ $kind }` के बाद `{"{"}` या `(` नहीं है
core-bib-comment-not-closed = एक टिप्पणी जो कभी बंद नहीं होती
core-bib-entry-not-closed = प्रविष्टि `{ $key }` कभी बंद नहीं होती
core-bib-expected-field = `{ $key }` में: फ़ील्ड के नाम की अपेक्षा थी, पर `{ $found }` मिला
core-bib-field-without-value = `{ $key }` में: फ़ील्ड `{ $field }` का कोई मान नहीं
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = `{ $key }` में, फ़ील्ड `{ $field }`: { $message }
core-bib-brace-not-closed = एक कोष्ठक जो कभी बंद नहीं होता
core-bib-quote-not-closed = एक उद्धरण चिह्न जो कभी बंद नहीं होता
core-bib-expected-value = मान की अपेक्षा थी, पर `{ $found }` मिला
core-bib-abbreviation = संक्षेप `{ $name }` परिभाषित नहीं है
core-bib-ended-in-value = फ़ाइल एक मान के बीच में ख़त्म हो गई
