# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = टिप्पणियाँ
comments-between = नक्शे और टिप्पणियों के बीच
comments-comment-on = टिप्पणी करें…
comments-comment = टिप्पणी
comments-write = टिप्पणी लिखें। Enter भेजता है; Shift+Enter नई पंक्ति है।
# $name: the element the comment is on.
comments-on = “{ $name }” पर
comments-answer = उत्तर दें…
comments-which = कौन-सी टिप्पणियाँ दिखें
comments-open = { $count ->
    [0] खुली
   *[other] खुली ({ $count })
}
comments-settled = { $count ->
    [0] निपटी
   *[other] निपटी ({ $count })
}
comments-all = सब
comments-none = अभी कोई टिप्पणी नहीं
comments-none-detail = कुछ पाठ चुनकर Ctrl+Alt+C दबाएँ, या किसी तत्व के मेनू से टिप्पणी करें… चुनें। टिप्पणी कभी पाठ का हिस्सा नहीं होती।
comments-none-of-these = इनमें से कोई नहीं।
comments-settle = सूत्र-वार्ता निपटाएँ
comments-reopen = सूत्र-वार्ता फिर खोलें
comments-edit = बदलें
comments-edited = बदली गई
comments-someone = कोई
comments-note-deleted = यह नोट मिटा दिया गया
# On an element in the diagram, and in the margin of the text.
comments-element-hint = तत्व पर जाने के लिए दबाएँ; उसमें लिखने के लिए दो बार दबाएँ
comments-mark = { $count ->
    [one] एक खुली टिप्पणी
   *[other] { $count } खुली टिप्पणियाँ
}
comments-show-cards = हर टिप्पणी उसके तत्व के नीचे दिखाएँ
comments-mark-hint = { $count ->
    [one] एक खुली टिप्पणी: तत्व के नीचे दिखाने या छिपाने के लिए दबाएँ
   *[other] { $count } खुली टिप्पणियाँ: तत्व के नीचे दिखाने या छिपाने के लिए दबाएँ
}
