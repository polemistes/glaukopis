# 中核がスペルチェックについて言うこと（日本語）。locales/README.md を見よ。

# $name は辞書のファイルの名前：nb_NO。$message はその理由。
spelling-unreadable = 辞書{ $name }を読み込めませんでした：{ $message }
spelling-encoding = 辞書{ $name }は読み込めない文字コードで書かれています。
# 「見つかりません：」の後に来る。$language はマップの言語：nb、en-GB。
spelling-dictionary-for = 「{ $language }」の辞書
spelling-not-a-word = 「{ $word }」は登録語に追加できません。
spelling-not-a-language = 「{ $language }」には登録語を保存できません。
# $language は一覧の言語（en、nb）。$message はその理由。
spelling-own-unreadable = 「{ $language }」の登録語を読み込めませんでした：{ $message }
# $path はファイルを移した先で、もとの場所の隣。
spelling-own-set-aside = 「{ $language }」の登録語を読み込めなかったため（{ $message }）、語は変更されませんでした。ファイルは{ $path }に退避しました。今追加する語は、新しい一覧の始まりになります。
