# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = 名前のない@string
core-bib-expected-found = `{ $expected }`があるべきところに`{ $found }`があります
core-bib-expected-end = `{ $expected }`があるべきところでファイルが終わっています
core-bib-expected-brace = `@{ $kind }`の後に`{"{"}`も`(`もありません
core-bib-comment-not-closed = 閉じられていないコメント
core-bib-entry-not-closed = 項目`{ $key }`が閉じられていません
core-bib-expected-field = `{ $key }`内：フィールド名があるべきところに`{ $found }`があります
core-bib-field-without-value = `{ $key }`内：フィールド`{ $field }`に値がありません
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = `{ $key }`のフィールド`{ $field }`：{ $message }
core-bib-brace-not-closed = 閉じられていない波括弧
core-bib-quote-not-closed = 閉じられていない引用符
core-bib-expected-value = 値があるべきところに`{ $found }`があります
core-bib-abbreviation = 略語`{ $name }`が定義されていません
core-bib-ended-in-value = 値の途中でファイルが終わっています
