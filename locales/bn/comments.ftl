# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = মন্তব্য
comments-between = নকশা ও মন্তব্যের মাঝে
comments-comment-on = মন্তব্য করুন…
comments-comment = মন্তব্য
comments-write = একটি মন্তব্য লিখুন। Enter পাঠায়; Shift+Enter নতুন লাইন।
# $name: the element the comment is on.
comments-on = “{ $name }”-এর ওপর
comments-answer = উত্তর দিন…
comments-which = কোন মন্তব্যগুলো দেখানো হচ্ছে
comments-open = { $count ->
    [0] খোলা
   *[other] খোলা ({ $count })
}
comments-settled = { $count ->
    [0] মীমাংসিত
   *[other] মীমাংসিত ({ $count })
}
comments-all = সব
comments-none = এখনও কোনো মন্তব্য নেই
comments-none-of-these = এগুলোর কোনোটিই নয়।
comments-none-detail = কিছু লেখা নির্বাচন করে Ctrl+Alt+C চাপুন, বা কোনো উপাদানের মেনু থেকে “মন্তব্য করুন…” বেছে নিন। মন্তব্য কখনও পাঠের অংশ হয় না।
comments-settle = আলোচনার মীমাংসা করুন
comments-reopen = আলোচনা আবার খুলুন
comments-edit = বদলান
comments-edited = বদলানো হয়েছে
comments-someone = কেউ একজন
comments-note-deleted = নোটটি মুছে ফেলা হয়েছে
# On an element in the diagram, and in the margin of the text.
comments-element-hint = উপাদানে যেতে চাপুন; তাতে লিখতে দুবার চাপুন
comments-mark = { $count ->
    [one] একটি খোলা মন্তব্য
   *[other] { $count }টি খোলা মন্তব্য
}
comments-show-cards = প্রতিটি মন্তব্য তার উপাদানের নিচে দেখান
comments-mark-hint = { $count ->
    [one] একটি খোলা মন্তব্য: উপাদানের নিচে দেখাতে বা লুকাতে চাপুন
   *[other] { $count }টি খোলা মন্তব্য: উপাদানের নিচে দেখাতে বা লুকাতে চাপুন
}
