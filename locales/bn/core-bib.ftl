# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = নামহীন একটি @string
core-bib-expected-found = `{ $expected }` প্রত্যাশিত ছিল, কিন্তু পাওয়া গেল `{ $found }`
core-bib-expected-end = `{ $expected }` প্রত্যাশিত ছিল, কিন্তু ফাইল শেষ হয়ে গেল
core-bib-expected-brace = `@{ $kind }`-এর পরে `{"{"}` বা `(` নেই
core-bib-comment-not-closed = একটি মন্তব্য যা কখনও বন্ধ হয়নি
core-bib-entry-not-closed = `{ $key }` ভুক্তিটি কখনও বন্ধ হয়নি
core-bib-expected-field = `{ $key }`-এ: একটি ক্ষেত্রের নাম প্রত্যাশিত ছিল, কিন্তু পাওয়া গেল `{ $found }`
core-bib-field-without-value = `{ $key }`-এ: `{ $field }` ক্ষেত্রটির কোনো মান নেই
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = `{ $key }`-এ, `{ $field }` ক্ষেত্রে: { $message }
core-bib-brace-not-closed = একটি বন্ধনী যা কখনও বন্ধ হয়নি
core-bib-quote-not-closed = একটি উদ্ধৃতিচিহ্ন যা কখনও বন্ধ হয়নি
core-bib-expected-value = একটি মান প্রত্যাশিত ছিল, কিন্তু পাওয়া গেল `{ $found }`
core-bib-abbreviation = `{ $name }` সংক্ষেপটির সংজ্ঞা দেওয়া নেই
core-bib-ended-in-value = একটি মানের মাঝখানে ফাইল শেষ হয়ে গেল
