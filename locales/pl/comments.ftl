# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Komentarze
comments-between = Między mapą a komentarzami
comments-comment-on = Skomentuj…
comments-comment = Komentarz
comments-write = Napisz komentarz. Enter wysyła; Shift+Enter zaczyna nowy wiersz.
# $name: the element the comment is on.
comments-on = Do „{ $name }”
comments-answer = Odpowiedz…
comments-which = Które komentarze pokazać
comments-open = { $count ->
    [0] Otwarte
   *[other] Otwarte ({ $count })
}
comments-settled = { $count ->
    [0] Rozwiązane
   *[other] Rozwiązane ({ $count })
}
comments-all = Wszystkie
comments-none = Nie ma jeszcze komentarzy
comments-none-detail = Zaznacz tekst i naciśnij Ctrl+Alt+C albo wybierz Skomentuj… z menu elementu. Komentarz nigdy nie jest częścią tekstu.
comments-none-of-these = Nie ma takich.
comments-settle = Rozwiąż wątek
comments-reopen = Otwórz wątek na nowo
comments-edit = Zmień
comments-edited = zmieniono
comments-someone = Ktoś
comments-note-deleted = Notatka została usunięta
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Naciśnij, by przejść do elementu; naciśnij dwa razy, by w nim pisać
comments-mark = { $count ->
    [one] Jeden otwarty komentarz
    [few] { $count } otwarte komentarze
    [many] { $count } otwartych komentarzy
   *[other] { $count } otwartych komentarzy
}
comments-show-cards = Pokaż każdy komentarz pod jego elementem
comments-mark-hint = { $count ->
    [one] Jeden otwarty komentarz: naciśnij, by pokazać go pod elementem albo ukryć
    [few] { $count } otwarte komentarze: naciśnij, by pokazać je pod elementem albo ukryć
    [many] { $count } otwartych komentarzy: naciśnij, by pokazać je pod elementem albo ukryć
   *[other] { $count } otwartych komentarzy: naciśnij, by pokazać je pod elementem albo ukryć
}
