# A map as a diagram: the elements on a canvas, their branches and associations.

diagram-map = Mapa
diagram-idea = Nazwa
diagram-new-loose = Nowy luźny element tutaj
diagram-new-loose-hint = Myśl, która nie ma jeszcze miejsca
diagram-show-all = Pokaż całą mapę
diagram-tidy = Uporządkuj całą mapę
diagram-tidy-hint = Każdy element wraca na swoje automatyczne miejsce
# The keys are shown as keys, where the variables stand.
diagram-hint-empty = { $tab } dodaje element pod zaznaczonym · { $enter } dodaje element obok · dwuklik, by pisać
diagram-hint-linking = Kliknij element, z którym chcesz powiązać, albo przejdź do niego strzałkami i naciśnij { $enter } · { $esc }, by zrezygnować
diagram-show-under = Pokaż, co jest pod nim
diagram-hide-under = Ukryj, co jest pod nim
diagram-link-handle = Przeciągnij do innego elementu, by je powiązać

## The view

diagram-view = Widok
diagram-zoom-out = Pomniejsz
diagram-zoom-in = Powiększ
diagram-actual-size = Rzeczywisty rozmiar
# How large the map is shown, in hundredths of its size.
diagram-zoom = { $percent }%

## Copying and pasting elements.

diagram-copied = { $count ->
    [one] Skopiowano jeden element ze wszystkim, co pod nim
    [few] Skopiowano { $count } elementy ze wszystkim, co pod nimi
    [many] Skopiowano { $count } elementów ze wszystkim, co pod nimi
   *[other] Skopiowano { $count } elementów ze wszystkim, co pod nimi
}
diagram-nothing-copied = Nic jeszcze nie skopiowano
diagram-pasted-elsewhere = To, co skopiowano, należy do innego projektu i nie da się tego tu wkleić
