# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = @string bez nazwy
core-bib-expected-found = oczekiwano `{ $expected }`, a znaleziono `{ $found }`
core-bib-expected-end = oczekiwano `{ $expected }`, a plik się skończył
core-bib-expected-brace = po `@{ $kind }` nie ma `{"{"}` ani `(`
core-bib-comment-not-closed = komentarz, który nigdy się nie zamyka
core-bib-entry-not-closed = wpis `{ $key }` nigdy się nie zamyka
core-bib-expected-field = w `{ $key }`: oczekiwano nazwy pola, a znaleziono `{ $found }`
core-bib-field-without-value = w `{ $key }`: pole `{ $field }` nie ma wartości
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = w `{ $key }`, pole `{ $field }`: { $message }
core-bib-brace-not-closed = nawias klamrowy, który nigdy się nie zamyka
core-bib-quote-not-closed = cudzysłów, który nigdy się nie zamyka
core-bib-expected-value = oczekiwano wartości, a znaleziono `{ $found }`
core-bib-abbreviation = skrót `{ $name }` nie jest zdefiniowany
core-bib-ended-in-value = plik skończył się w środku wartości
