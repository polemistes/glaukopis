kinds-elements = { $count ->
    [one] { $count } element
    [few] { $count } elementy
    [many] { $count } elementów
   *[other] { $count } elementów
}
kinds-delete-title = Usunąć rodzaj „{ $name }”?
kinds-delete-message = { $count ->
    [0] Żaden element nie jest tego rodzaju.
    [one] Ten jeden element, który jest tego rodzaju, nie będzie miał rodzaju.
    [few] { $count } elementy, które są tego rodzaju, nie będą miały rodzaju.
    [many] { $count } elementów, które są tego rodzaju, nie będzie miało rodzaju.
   *[other] { $count } elementów, które są tego rodzaju, nie będzie miało rodzaju.
}
