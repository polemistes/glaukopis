# What the core says of spelling, in English. See locales/README.md.

# $name is the name of the dictionary's files: nb_NO. $message says why.
spelling-unreadable = Nie udało się odczytać słownika { $name }: { $message }
spelling-encoding = Słownik { $name } jest zapisany w kodowaniu, którego nie da się odczytać.
# Stands after "not found:". $language is the language of a map: nb, en-GB.
spelling-dictionary-for = słownik dla „{ $language }”
spelling-not-a-word = „{ $word }” nie da się dodać do twoich słów.
spelling-not-a-language = Własnych słów nie da się przechowywać dla „{ $language }”.
