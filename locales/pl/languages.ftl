# The languages of a map and of a project: the dialog opened from the menu
# of a map (ADR 0020).

languages-menu = Języki…
languages-dialog = Języki
languages-dialog-subtitle = Język tej mapy i map, które powstaną
languages-map = Język tej mapy
# What follows from the language of a map: the words its document prints in
# words of its own, the dictionary of its spelling, the quotation marks of a mention.
languages-map-hint = Decyduje o słowach, które jej dokument drukuje własnymi słowami, jak „Przypisy” i „Rycina”; o słowniku, którym sprawdzana jest jej pisownia; i o cudzysłowie, w jakim stoi omawiane słowo.
# A map that was given no language is printed in English.
languages-map-none = Niepodany (angielski)
languages-project = Język nowych map w tym projekcie
languages-project-hint = W czym pisana jest mapa utworzona w tym projekcie, dla wszystkich, którym projekt udostępniono. Mapa zrobiona z dokumentu zachowuje język dokumentu. Każdej mapie można dać inny powyżej.
# Where the project chooses none, the settings' language of new texts holds; it is named.
languages-project-settings = Jak w ustawieniach ({ $language })
