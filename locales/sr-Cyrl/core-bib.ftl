# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = @string без имена
core-bib-expected-found = очекивано је `{ $expected }`, а нађено `{ $found }`
core-bib-expected-end = очекивано је `{ $expected }`, а датотека се завршила
core-bib-expected-brace = после `@{ $kind }` не следи ни `{"{"}` ни `(`
core-bib-comment-not-closed = коментар који се нигде не затвара
core-bib-entry-not-closed = унос `{ $key }` се нигде не затвара
core-bib-expected-field = у `{ $key }`: очекивано је име поља, а нађено `{ $found }`
core-bib-field-without-value = у `{ $key }`: поље `{ $field }` нема вредност
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = у `{ $key }`, поље `{ $field }`: { $message }
core-bib-brace-not-closed = витичаста заграда која се нигде не затвара
core-bib-quote-not-closed = наводник који се нигде не затвара
core-bib-expected-value = очекивана је вредност, а нађено `{ $found }`
core-bib-abbreviation = скраћеница `{ $name }` није дефинисана
core-bib-ended-in-value = датотека се завршила усред вредности
