kinds-name = Назив
kinds-name-placeholder = Лик, место, догађај…
kinds-name-taken = Већ постоји врста с тим називом.
kinds-colour = Боја
kinds-colour-teal = Плавозелена
kinds-colour-amber = Ћилибарна
kinds-colour-violet = Љубичаста
kinds-colour-rose = Ружичаста
kinds-colour-green = Зелена
kinds-colour-blue = Плава
kinds-colour-rust = Рђаста
kinds-colour-olive = Маслинаста
kinds-colour-slate = Шкриљаста
kinds-colour-plum = Шљивина
