kinds-create = Направи
kinds-elements = { $count ->
    [one] { $count } елемент
    [few] { $count } елемента
   *[other] { $count } елемената
}
kinds-delete-title = Обрисати врсту „{ $name }“?
kinds-delete-message = { $count ->
    [0] Ниједан елемент није те врсте.
    [one] { $count } елемент те врсте неће бити ни једне врсте.
    [few] { $count } елемента те врсте неће бити ни једне врсте.
   *[other] { $count } елемената те врсте неће бити ни једне врсте.
}
