# The languages of a map and of a project: the dialog opened from the menu
# of a map (ADR 0020).

languages-menu = Језици…
languages-dialog = Језици
languages-dialog-subtitle = Језик ове мапе, и мапа које долазе
languages-map = Језик ове мапе
# What follows from the language of a map: the words its document prints in
# words of its own, the dictionary of its spelling, the quotation marks of a mention.
languages-map-hint = Одређује речи које њен документ штампа сопственим речима, као што су „Напомене“ и „Слика“; речник по коме се проверава њен правопис; и наводнике у којима стоји помен.
# A map that was given no language is printed in English.
languages-map-none = Није наведен (енглески)
languages-project = Језик нових мапа у овом пројекту
languages-project-hint = На чему се пише мапа направљена у овом пројекту, за све с којима се пројекат дели. Мапа направљена из документа задржава језик документа. Свакој мапи може се горе дати други.
# Where the project chooses none, the settings' language of new texts holds; it is named.
languages-project-settings = Као у подешавањима ({ $language })
