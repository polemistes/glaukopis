# A map as a diagram: the elements on a canvas, their branches and associations.

diagram-map = Мапа
diagram-idea = Назив
diagram-new-loose = Нови слободан елемент овде
diagram-new-loose-hint = Мисао која још нема своје место
diagram-show-all = Прикажи целу мапу
diagram-tidy = Среди целу мапу
diagram-tidy-hint = Сваки елемент се враћа на своје аутоматско место
# The keys are shown as keys, where the variables stand.
diagram-hint-empty = { $tab } додаје елемент под изабраним · { $enter } додаје један поред њега · двоструки клик за писање
diagram-hint-linking = Кликните на елемент с којим се повезује, или дођите до њега стрелицама и притисните { $enter } · { $esc } за одустајање
diagram-show-under = Прикажи шта је под њим
diagram-hide-under = Сакриј шта је под њим
diagram-link-handle = Превуците до другог елемента да их повежете

## The view

diagram-view = Приказ
diagram-zoom-out = Умањи
diagram-zoom-in = Увећај
diagram-actual-size = Стварна величина
# How large the map is shown, in hundredths of its size.
diagram-zoom = { $percent }%

## Copying and pasting elements.

diagram-copied = { $count ->
    [one] { $count } елемент копиран, са свим под њим
    [few] { $count } елемента копирана, са свим под њима
   *[other] { $count } елемената копирано, са свим под њима
}
diagram-nothing-copied = Још ништа није копирано
diagram-pasted-elsewhere = Копирано је из другог пројекта и не може се налепити овде
