# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Коментари
comments-between = Између мапе и коментара
comments-comment-on = Коментариши…
comments-comment = Коментариши
comments-write = Напишите коментар. Enter га шаље; Shift+Enter је нови ред.
# $name: the element the comment is on.
comments-on = Уз „{ $name }“
comments-answer = Одговори…
comments-which = Који се коментари приказују
comments-open = { $count ->
    [0] Отворени
   *[other] Отворени ({ $count })
}
comments-settled = { $count ->
    [0] Решени
   *[other] Решени ({ $count })
}
comments-all = Сви
comments-none = Још нема коментара
comments-none-detail = Изаберите текст и притисните Ctrl+Alt+C, или изаберите „Коментариши…“ из менија елемента. Коментар никад није део текста.
comments-none-of-these = Ниједан од ових.
comments-settle = Реши нит
comments-reopen = Поново отвори нит
comments-edit = Измени
comments-edited = измењено
comments-someone = Неко
comments-note-deleted = Белешка је обрисана
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Притисните да одете на елемент; притисните двапут да пишете у њему
comments-mark = { $count ->
    [one] { $count } отворен коментар
    [few] { $count } отворена коментара
   *[other] { $count } отворених коментара
}
comments-show-cards = Прикажи сваки коментар под његовим елементом
comments-mark-hint = { $count ->
    [one] { $count } отворен коментар: притисните да га прикажете под елементом, или да га сакријете
    [few] { $count } отворена коментара: притисните да их прикажете под елементом, или да их сакријете
   *[other] { $count } отворених коментара: притисните да их прикажете под елементом, или да их сакријете
}
