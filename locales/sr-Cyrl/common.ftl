## How long ago something was: "Changed { $ago }".

time-just-now = управо сада
time-minutes-ago = { $count ->
    [one] пре { $count } минут
    [few] пре { $count } минута
   *[other] пре { $count } минута
}
time-hours-ago = { $count ->
    [one] пре { $count } сат
    [few] пре { $count } сата
   *[other] пре { $count } сати
}
time-yesterday = јуче
time-days-ago = { $count ->
    [one] пре { $count } дан
    [few] пре { $count } дана
   *[other] пре { $count } дана
}
