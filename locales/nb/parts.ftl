# Typene av elementer som utgjør et dokument, og som følger med programmet
# (ADR 0038): hva hver heter i typemenyen og på merkelappen til et element.
# Kjernen har de samme typene, med utseendet deres.

parts-group-front = Forstoff
parts-group-back = Etterstoff
parts-group-cover = Omslag
parts-more = Flere …

# Grunntypene.
parts-front-section = Avsnitt foran
parts-back-section = Avsnitt bak
parts-own-page = Egen side
parts-cover = Omslag

# Forstoff.
parts-abstract = Sammendrag
parts-dedication = Tilegnelse
parts-epigraph = Epigraf
parts-copyright = Kolofon
parts-foreword = Forord
parts-preface = Innledning
parts-cast = Rolleliste
parts-setting = Sted og tid
parts-standfirst = Ingress

# Etterstoff.
parts-acknowledgements = Takk
parts-appendix = Vedlegg
parts-afterword = Etterord
parts-glossary = Ordliste
parts-about-the-author = Om forfatteren
parts-signature = Signatur

# Omslaget.
parts-blurb = Baksidetekst

# På merkelappen til et element nummer to av en type et dokument har ett av.
parts-doubled = Skrives ikke ut: et annet element av denne typen kommer først blant søsknene.

## Where a kind puts an element in the document, where not where it stands.

parts-placed-front = Skrives ut først, foran resten på sitt nivå
parts-placed-back = Skrives ut sist, etter resten på sitt nivå
parts-placed-cover = Skrives bare ut på omslaget
parts-placed-none = Skrives ikke ut i dokumentet
parts-placed-front-short = skrives ut først
parts-placed-back-short = skrives ut sist
parts-placed-cover-short = bare på omslaget
parts-placed-none-short = skrives ikke ut
