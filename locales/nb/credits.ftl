# Æren for Glaukopis: det programmet bygger på og kommer med, med lisensene,
# i vinduet som en knapp i Om-delen av innstillingene åpner. Navnene på
# prosjektene og lisensene deres oversettes ikke: de står i
# src/lib/settings/credits.ts.

credits-button = Bidrag og lisenser…
credits-title = Bidrag og lisenser
credits-own-licence = Glaukopis er fri programvare under GNU General Public License, versjon 3 eller senere (GPL-3.0-or-later). Det er laget med arbeidet til prosjektene nedenfor, under lisensene de gir.
# Foran opphavspersonene til et prosjekt, der lisensen ber om at de nevnes.
credits-by = Av { $who }
# Hva et navn står for når det er en lenke: «Åpner { $url }».
credits-open = Åpner { $url }

