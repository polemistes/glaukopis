# Det kjernen sier om feil i en fil med BibTeX eller BibLaTeX, på bokmål.
# De vises etter linjen de står på. Se locales/README.md.

core-bib-string-without-name = en @string uten navn
core-bib-expected-found = ventet `{ $expected }`, men fant `{ $found }`
core-bib-expected-end = ventet `{ $expected }`, men filen sluttet
core-bib-comment-not-closed = en kommentar som aldri lukkes
core-bib-entry-not-closed = oppføringen `{ $key }` lukkes aldri
core-bib-expected-field = i `{ $key }`: ventet navnet på et felt, men fant `{ $found }`
core-bib-field-without-value = i `{ $key }`: feltet `{ $field }` har ingen verdi
core-bib-in-field = i `{ $key }`, feltet `{ $field }`: { $message }
core-bib-brace-not-closed = en klammeparentes som aldri lukkes
core-bib-quote-not-closed = et anførselstegn som aldri lukkes
core-bib-expected-value = ventet en verdi, men fant `{ $found }`
core-bib-abbreviation = forkortelsen `{ $name }` er ikke definert
core-bib-ended-in-value = filen sluttet midt i en verdi
