# Synkroniseringen mellom enhetene til den som skriver, datamaskiner og
# telefoner, på bokmål: delen av innstillingene, og det som sies når et
# prosjekt ble skrevet i på to enheter hver for seg. Se locales/README.md.

sync-title = Synkronisering
sync-about = Prosjekter, biblioteket, notatblokken og innstillingene dine blir synkronisert mellom enhetene.
# Under overskriften på en enhet som bare tar imot notatene, en telefon.
sync-about-notes = Bare notatblokken blir synkronisert.

## Før den er slått på.

sync-server = Server
sync-computer-name = Navn på denne enheten
sync-how = Hvordan denne enheten begynner
sync-how-start = Begynn her
sync-how-join = Bruk en kode
sync-password = Passordet til serveren
sync-code = Kode
sync-start = Start synkronisering
sync-starting = Starter …
sync-join = Bli med
sync-joining = Blir med …
sync-unreachable = Serveren kunne ikke nås.

## Mens den er slått på.

sync-working = Synkroniserer …
sync-last = Sist synkronisert { $when }
sync-never = Ikke synkronisert ennå
sync-offline = Serveren kan ikke nås. Det som skrives her, tas vare på og sendes når det går.
sync-refused = Synkroniseringen har stoppet på denne enheten
# Linjen over notatene på en telefon der appen er eldre enn formen på noe av det som synkroniseres: synkroniseringen har stoppet der til appen er oppdatert. Ordene er eierens, og kjernen sier det samme i innstillingene (core-sync-update-needed).
sync-outdated = Oppdatering trengs for synkronisering.
sync-now = Synkroniser nå
sync-computers = Enheter
sync-this-computer = { $name } (denne enheten)
sync-seen = Sist sett { $when }
sync-computers-unread = Serveren kunne ikke spørres om hvilke enheter som er med.
sync-add = Legg til en enhet …
sync-code-hint = Skriv inn koden på den andre enheten, med { $join } under Synkronisering i innstillingene der. Den kan brukes én gang, til klokken { $until }.
sync-code-failed = Det kunne ikke lages noen kode.
sync-rename-title = Gi enheten nytt navn
sync-remove-title = Fjerne «{ $name }»?
sync-remove-message = Den synkroniseres ikke lenger. Det som er på den, blir der.
sync-remove-failed = «{ $name }» kunne ikke fjernes. { $why }
sync-stop = Slutt å synkronisere på denne enheten
sync-stop-title = Slutte å synkronisere på denne enheten?
sync-stop-message = Det som er på denne enheten, blir her som det er. Det som skrives på de andre enhetene dine, kommer ikke lenger hit, og det som skrives her, går ikke lenger til dem.
sync-stop-message-alone = Det som er på denne enheten, blir her som det er. Den er den eneste enheten som synkroniseres, så ingenting blir igjen på serveren.
# Der enheten som stopper, er den siste og bare tar imot notatene, en telefon: det serveren har av resten, slettes også.
sync-stop-message-alone-notes = Det som er på denne enheten, blir her som det er. Den er den eneste enheten som synkroniseres, så ingenting blir igjen på serveren. Prosjektene dine og filene i biblioteket er ikke på denne enheten: det serveren har av dem, blir slettet.
sync-stop-confirm = Slutt å synkronisere
sync-stop-failed = Synkroniseringen kunne ikke stoppes

## Skrevet hver for seg.

sync-apart = «{ $name }» ble skrevet i på to enheter mens de var uten forbindelse med hverandre.
sync-apart-show = Vis endringene
sync-apart-no-history = Historikken til prosjektet tas ikke vare på, så endringene kan ikke vises. Prosjektet slik det var før, ligger blant de tidligere versjonene.
sync-apart-earlier = Tidligere versjoner
sync-apart-moment = enhetene møttes
