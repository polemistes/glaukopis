# Synkroniseringen mellom datamaskinene til den som skriver, på bokmål:
# delen av innstillingene, og det som sies når et prosjekt ble skrevet i på
# to datamaskiner hver for seg. Se locales/README.md.

sync-title = Synkronisering
sync-about = Prosjektene, biblioteket, notatblokken og innstillingene dine, de samme på hver av datamaskinene dine, gjennom en server.

## Før den er slått på.

sync-server = Server
sync-computer-name = Navn på denne datamaskinen
sync-how = Hvordan denne datamaskinen begynner
sync-how-start = Begynn her
sync-how-join = Bruk en kode
sync-password = Passordet til serveren
sync-code = Kode
sync-start = Start synkronisering
sync-starting = Starter …
sync-join = Bli med
sync-joining = Blir med …
sync-unreachable = Serveren kunne ikke nås.

## Mens den er slått på.

sync-working = Synkroniserer …
sync-last = Sist synkronisert { $when }
sync-never = Ikke synkronisert ennå
sync-offline = Serveren kan ikke nås. Det som skrives her, tas vare på og sendes når det går.
sync-refused = Synkroniseringen har stoppet på denne datamaskinen
sync-now = Synkroniser nå
sync-computers = Datamaskiner
sync-this-computer = { $name } (denne datamaskinen)
sync-seen = Sist sett { $when }
sync-computers-unread = Serveren kunne ikke spørres om hvilke datamaskiner som er med.
sync-add = Legg til en datamaskin …
sync-code-hint = Skriv inn koden på den andre datamaskinen, med { $join } under Synkronisering i innstillingene der. Den kan brukes én gang, til klokken { $until }.
sync-code-failed = Det kunne ikke lages noen kode.
sync-rename-title = Gi datamaskinen nytt navn
sync-remove-title = Fjerne «{ $name }»?
sync-remove-message = Den synkroniseres ikke lenger. Det som er på den, blir der.
sync-remove-failed = «{ $name }» kunne ikke fjernes. { $why }
sync-stop = Slutt å synkronisere på denne datamaskinen
sync-stop-title = Slutte å synkronisere på denne datamaskinen?
sync-stop-message = Det som er på denne datamaskinen, blir her som det er. Det som skrives på de andre datamaskinene dine, kommer ikke lenger hit, og det som skrives her, går ikke lenger til dem.
sync-stop-message-alone = Det som er på denne datamaskinen, blir her som det er. Den er den eneste datamaskinen som synkroniseres, så ingenting blir igjen på serveren.
sync-stop-confirm = Slutt å synkronisere
sync-stop-failed = Synkroniseringen kunne ikke stoppes

## Skrevet hver for seg.

sync-apart = «{ $name }» ble skrevet i på to datamaskiner mens de var uten forbindelse med hverandre.
sync-apart-show = Vis endringene
sync-apart-no-history = Historikken til prosjektet tas ikke vare på, så endringene kan ikke vises. Prosjektet slik det var før, ligger blant de tidligere versjonene.
sync-apart-earlier = Tidligere versjoner
sync-apart-moment = datamaskinene møttes
