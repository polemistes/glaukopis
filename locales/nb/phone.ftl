# Siden på telefonen, på bokmål: de få ordene som er dens egne. Resten er
# notatblokkens, innstillingenes, synkroniseringens og redigeringens. Se
# locales/README.md.

# Pilen øverst i et notat og i innstillingene.
phone-back = Tilbake
# Knappen øverst i et notat som åpner det mer som kan gjøres med det.
phone-more = Mer
# Linjen over notatene: det som ble skrevet her, har ikke nådd serveren, som ikke kan nås nå.
phone-waiting = Tatt vare på her, og sendes når serveren kan nås
# Linjen over notatene: synkroniseringen sier at noe er galt; trykket på, åpner den innstillingene, som sier hva.
phone-problem = Noe er galt med synkroniseringen
# Knappen i raden over tastaturet som åpner telefonens kamera, og setter bildet som ble tatt inn i notatet.
phone-photograph = Ta bilde
# Knappen i raden over tastaturet som åpner systemets velger, og setter bildene og filene som ble valgt inn i notatet.
phone-picture-or-file = Bilde eller fil
# Sagt under overskriften om at noen filer ikke kunne tas inn, om en valgt fil som er større enn et notat tar; $most er et antall megabyte.
phone-file-too-large = { $name } er større enn { $most } MB
