# Det kjernen sier om bildelageret, på bokmål.
# Se locales/README.md.

core-pictures-not-a-picture = filen er ikke et bilde av en type som kan brukes: PNG, JPEG, SVG, GIF, WebP, TIFF eller BMP
core-pictures-unreadable = bildet kunne ikke leses: { $error }
core-pictures-not-a-name = dette er ikke navnet på et bilde
core-pictures-not-as-asked = det som kom, er ikke bildet det ble bedt om
core-pictures-needs-name = et bilde må ha et navn
core-pictures-too-large = bildet er større enn { $most } MB, som er det meste et bilde kan være
core-pictures-not-whole = bildet kom ikke helt fram
core-pictures-the-picture = bildet
core-pictures-unnamed = bilde
