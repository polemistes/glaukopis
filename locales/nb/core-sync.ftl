# Det kjernen sier om synkronisering mellom skriverens datamaskiner, på bokmål.
# Se locales/README.md.

## Det som ligger på disken.

# Byte som skulle være en endring i et dokument og ikke lar seg lese som det.
# Grunnen er bibliotekets, på engelsk.
core-sync-not-a-change = En endring i et dokument lar seg ikke lese: { $why }

## Tjeneren.

core-sync-old-server = Tjeneren på { $host } er eldre enn denne versjonen av Glaukopis og kan ikke synkronisere. Den må oppdateres.
core-sync-refused = Tjeneren slipper ikke lenger inn denne datamaskinen. Den ble tatt ut av dem som synkroniseres, eller ingenting av dem er lenger lagret på tjeneren.
core-sync-later-home = En annen av datamaskinene dine har en nyere versjon av Glaukopis, som lagrer det som synkroniseres, i en form denne versjonen ikke kjenner. Oppdater Glaukopis her.

## Å slå det på, og datamaskinene.

core-sync-not-on = Denne datamaskinen synkroniseres ikke.
core-sync-already = Denne datamaskinen synkroniseres allerede.
core-sync-needs-name = Gi denne datamaskinen et navn.
core-sync-remove-self = Denne datamaskinen tas ut ved å stoppe synkroniseringen her.

## Det som ikke lot seg synkronisere. Grunnen er en setning for seg.

core-sync-problem-project = «{ $name }» lot seg ikke synkronisere. { $why }
core-sync-problem-notebook = Notatblokken lot seg ikke synkronisere. { $why }
# Navnet på et prosjekt som kom fra en annen datamaskin og ikke sier noe navn selv.
core-sync-unnamed = Uten navn
