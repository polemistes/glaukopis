# Det kjernen sier om notatblokken, på bokmål.
# Se locales/README.md.

core-notebook-reading = kunne ikke lese notatblokken
core-notebook-picture-too-large = et bilde gitt til notatblokken er større enn { $most } MB
# Om et notat skrevet i et eget vindu (record 0109).
core-notebook-note-empty = et tomt notat sendes ikke
core-notebook-note-too-large = teksten i notatet er større enn { $most } MB
core-notebook-file-too-large = { $name } er større enn { $most } MB
# What was handed over by another app on a phone held neither words nor files; said after other words, so it begins with a small letter.
core-notebook-shared-empty = ingenting ble delt
# A file another app handed over could not be read from it; $name is what the other app calls the file.
core-notebook-shared-unread = { $name } kunne ikke leses
