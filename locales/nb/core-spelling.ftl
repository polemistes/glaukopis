# Det kjernen sier om staving, på bokmål. Se locales/README.md.

# $name er navnet på filene til ordboken: nb_NO. $message sier hvorfor.
spelling-unreadable = Ordboken { $name } kunne ikke leses: { $message }
spelling-encoding = Ordboken { $name } er skrevet i en tegnkoding som ikke kan leses.
# Står etter «ikke funnet:». $language er språket til et kart: nb, en-GB.
spelling-dictionary-for = en ordbok for «{ $language }»
spelling-not-a-word = «{ $word }» kan ikke legges til i ordene dine.
spelling-not-a-language = Det kan ikke lagres egne ord for «{ $language }».
# $language er språket til listen (en, nb); $message sier hvorfor.
spelling-own-unreadable = Dine egne ord for «{ $language }» kunne ikke leses: { $message }
# $path er der filen ble flyttet til, ved siden av der den lå.
spelling-own-set-aside = Dine egne ord for «{ $language }» kunne ikke leses ({ $message }), så ordet ble ikke endret. Filen er lagt til side som { $path }; et ord som legges til nå, begynner en ny liste.
