# What the core says of the store of pictures, in English.
# See locales/README.md.

core-pictures-not-a-picture = το αρχείο δεν είναι εικόνα είδους που μπορεί να χρησιμοποιηθεί: PNG, JPEG, SVG, GIF, WebP, TIFF ή BMP
core-pictures-unreadable = η εικόνα δεν διαβάζεται: { $error }
core-pictures-not-a-name = αυτό δεν ονομάζει εικόνα
core-pictures-not-as-asked = αυτό που έφτασε δεν είναι η εικόνα που ζητήθηκε
core-pictures-needs-name = μια εικόνα πρέπει να λέγεται κάπως
core-pictures-too-large = η εικόνα είναι μεγαλύτερη από { $most } MB, το μέγιστο που μπορεί να έχει μια εικόνα
core-pictures-not-whole = η εικόνα δεν έφτασε ολόκληρη
# Shown after "not found: ".
core-pictures-the-picture = η εικόνα
# What a picture that came without a name is called, before the ending of
# its file: "picture.png".
core-pictures-unnamed = εικόνα
