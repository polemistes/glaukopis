# A map as a diagram: the elements on a canvas, their branches and associations.

diagram-map = Χάρτης
diagram-idea = Όνομα
diagram-new-loose = Νέο ελεύθερο στοιχείο εδώ
diagram-new-loose-hint = Μια σκέψη που δεν έχει ακόμη θέση
diagram-show-all = Εμφάνιση όλου του χάρτη
diagram-tidy = Τακτοποίηση όλου του χάρτη
diagram-tidy-hint = Κάθε στοιχείο γυρίζει στην αυτόματη θέση του
# The keys are shown as keys, where the variables stand.
diagram-hint-empty = { $tab } προσθέτει στοιχείο κάτω από το επιλεγμένο · { $enter } προσθέτει ένα δίπλα του · διπλό κλικ για να γράψετε
diagram-hint-linking = Κάντε κλικ στο στοιχείο που θέλετε να συσχετίσετε, ή πηγαίνετε σε αυτό με τα βέλη και πατήστε { $enter } · { $esc } για να το αφήσετε
diagram-show-under = Εμφάνιση όσων είναι από κάτω του
diagram-hide-under = Απόκρυψη όσων είναι από κάτω του
diagram-link-handle = Σύρετε σε άλλο στοιχείο για να τα συσχετίσετε

## The view

diagram-view = Προβολή
diagram-zoom-out = Σμίκρυνση
diagram-zoom-in = Μεγέθυνση
diagram-actual-size = Πραγματικό μέγεθος
# How large the map is shown, in hundredths of its size.
diagram-zoom = { $percent }%

## Copying and pasting elements.

diagram-copied = { $count ->
    [one] Αντιγράφηκε ένα στοιχείο, με όλα όσα είναι από κάτω του
   *[other] Αντιγράφηκαν { $count } στοιχεία, με όλα όσα είναι από κάτω τους
}
diagram-nothing-copied = Δεν έχει αντιγραφεί τίποτα ακόμη
diagram-pasted-elsewhere = Αυτό που αντιγράφηκε είναι από άλλο έργο, και δεν μπορεί να επικολληθεί εδώ
