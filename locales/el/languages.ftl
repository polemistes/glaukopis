# The languages of a map and of a project: the dialog opened from the menu
# of a map (ADR 0020).

languages-menu = Γλώσσες…
languages-dialog = Γλώσσες
languages-dialog-subtitle = Η γλώσσα αυτού του χάρτη, και των χαρτών που θα έρθουν
languages-map = Η γλώσσα αυτού του χάρτη
# What follows from the language of a map: the words its document prints in
# words of its own, the dictionary of its spelling, the quotation marks of a mention.
languages-map-hint = Ορίζει τις λέξεις που τυπώνει το έγγραφό του από μόνο του, όπως «Σημειώσεις» και «Σχήμα»· το λεξικό με το οποίο ελέγχεται η ορθογραφία του· και τα εισαγωγικά μέσα στα οποία μπαίνει μια μνεία.
# A map that was given no language is printed in English.
languages-map-none = Δεν ορίζεται (αγγλικά)
languages-project = Η γλώσσα των νέων χαρτών σε αυτό το έργο
languages-project-hint = Σε τι γράφεται ένας χάρτης που φτιάχνεται σε αυτό το έργο, για όλους όσους μοιράζονται το έργο. Ένας χάρτης από έγγραφο κρατά τη γλώσσα του εγγράφου. Σε κάθε χάρτη μπορεί να δοθεί άλλη, παραπάνω.
# Where the project chooses none, the settings' language of new texts holds; it is named.
languages-project-settings = Όπως στις ρυθμίσεις ({ $language })
