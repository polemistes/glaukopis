# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Σχόλια
comments-between = Ανάμεσα στον χάρτη και στα σχόλια
comments-comment-on = Σχόλιο…
comments-comment = Σχόλιο
comments-write = Γράψτε ένα σχόλιο. Το Enter το στέλνει· Shift+Enter αλλάζει γραμμή.
# $name: the element the comment is on.
comments-on = Στο «{ $name }»
comments-answer = Απάντηση…
comments-which = Ποια σχόλια εμφανίζονται
comments-open = { $count ->
    [0] Ανοιχτά
   *[other] Ανοιχτά ({ $count })
}
comments-settled = { $count ->
    [0] Επιλυμένα
   *[other] Επιλυμένα ({ $count })
}
comments-all = Όλα
comments-none = Κανένα σχόλιο ακόμη
comments-none-detail = Επιλέξτε λίγο κείμενο και πατήστε Ctrl+Alt+C, ή διαλέξτε «Σχόλιο…» από το μενού ενός στοιχείου. Ένα σχόλιο δεν γίνεται ποτέ μέρος του κειμένου.
comments-none-of-these = Κανένα από αυτά.
comments-settle = Επίλυση του νήματος
comments-reopen = Άνοιγμα του νήματος ξανά
comments-edit = Αλλαγή
comments-edited = αλλαγμένο
comments-someone = Κάποιος
comments-note-deleted = Η σημείωση διαγράφηκε
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Πατήστε για να πάτε στο στοιχείο· πατήστε δύο φορές για να γράψετε σε αυτό
comments-mark = { $count ->
    [one] Ένα ανοιχτό σχόλιο
   *[other] { $count } ανοιχτά σχόλια
}
comments-show-cards = Εμφάνιση κάθε σχολίου κάτω από το στοιχείο του
comments-mark-hint = { $count ->
    [one] Ένα ανοιχτό σχόλιο: πατήστε για να το δείτε κάτω από το στοιχείο, ή να το κρύψετε
   *[other] { $count } ανοιχτά σχόλια: πατήστε για να τα δείτε κάτω από το στοιχείο, ή να τα κρύψετε
}
