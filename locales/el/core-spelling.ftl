# What the core says of spelling, in English. See locales/README.md.

# $name is the name of the dictionary's files: nb_NO. $message says why.
spelling-unreadable = Το λεξικό { $name } δεν διαβάζεται: { $message }
spelling-encoding = Το λεξικό { $name } είναι γραμμένο σε κωδικοποίηση που δεν διαβάζεται.
# Stands after "not found:". $language is the language of a map: nb, en-GB.
spelling-dictionary-for = λεξικό για «{ $language }»
spelling-not-a-word = Το «{ $word }» δεν μπορεί να προστεθεί στις λέξεις σας.
spelling-not-a-language = Δικές σας λέξεις δεν μπορούν να φυλαχτούν για «{ $language }».
