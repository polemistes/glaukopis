# Kinds of elements: what the writer calls them (character, place, source…), each with a colour.

kinds-kind = Είδος
kinds-title = Είδη στοιχείων
kinds-subtitle = Τι μπορούν να είναι τα στοιχεία αυτού του έργου: όσα είδη χρειάζεται η δουλειά, το καθένα με ένα χρώμα.
kinds-new = Νέο είδος
kinds-new-ellipsis = Νέο είδος…
kinds-change = Αλλαγή του είδους
kinds-manage = Είδη αυτού του έργου…
kinds-none-of-them = Κανένα
kinds-none = Κανένα είδος ακόμη. Ένα είδος είναι ένα όνομα και ένα χρώμα: χαρακτήρας, τόπος, γεγονός, πηγή, επιχείρημα, ό,τι χρειάζεται η δουλειά.
kinds-name = Όνομα
kinds-name-placeholder = Χαρακτήρας, τόπος, γεγονός…
kinds-name-taken = Υπάρχει ήδη είδος με αυτό το όνομα.
kinds-colour = Χρώμα
kinds-colour-teal = Πετρόλ
kinds-colour-amber = Κεχριμπαρί
kinds-colour-violet = Βιολετί
kinds-colour-rose = Ροζ
kinds-colour-green = Πράσινο
kinds-colour-blue = Μπλε
kinds-colour-rust = Σκουριά
kinds-colour-olive = Λαδί
kinds-colour-slate = Μολυβί
kinds-colour-plum = Δαμασκηνί
kinds-template = Κείμενο για αρχή
kinds-template-placeholder = Εμφάνιση
    Επιθυμίες
    Φόβοι
kinds-template-hint = Ένα στοιχείο χωρίς κείμενο που παίρνει αυτό το είδος αρχίζει με αυτές τις γραμμές, μία παράγραφο η καθεμία.
kinds-begins = Ένα στοιχείο αυτού του είδους γράφει σε
kinds-begins-hint = Το κείμενο αρχίζει σε αυτό το είδος παραγράφου, όπου το στοιχείο δεν έχει ακόμη κείμενο
kinds-create = Δημιουργία
kinds-elements = { $count ->
    [one] { $count } στοιχείο
   *[other] { $count } στοιχεία
}
kinds-delete-title = Διαγραφή του είδους «{ $name }»;
kinds-delete-message = { $count ->
    [0] Κανένα στοιχείο δεν είναι αυτού του είδους.
    [one] Το ένα στοιχείο που είναι αυτού του είδους θα μείνει χωρίς είδος.
   *[other] Τα { $count } στοιχεία που είναι αυτού του είδους θα μείνουν χωρίς είδος.
}
