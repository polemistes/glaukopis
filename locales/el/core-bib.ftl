# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = ένα @string χωρίς όνομα
core-bib-expected-found = αναμενόταν `{ $expected }` αλλά βρέθηκε `{ $found }`
core-bib-expected-end = αναμενόταν `{ $expected }` αλλά το αρχείο τελείωσε
core-bib-expected-brace = το `@{ $kind }` δεν ακολουθείται από `{"{"}` ή `(`
core-bib-comment-not-closed = ένα σχόλιο που δεν κλείνει ποτέ
core-bib-entry-not-closed = η εγγραφή `{ $key }` δεν κλείνει ποτέ
core-bib-expected-field = στο `{ $key }`: αναμενόταν όνομα πεδίου αλλά βρέθηκε `{ $found }`
core-bib-field-without-value = στο `{ $key }`: το πεδίο `{ $field }` δεν έχει τιμή
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = στο `{ $key }`, πεδίο `{ $field }`: { $message }
core-bib-brace-not-closed = ένα άγκιστρο που δεν κλείνει ποτέ
core-bib-quote-not-closed = ένα εισαγωγικό που δεν κλείνει ποτέ
core-bib-expected-value = αναμενόταν τιμή αλλά βρέθηκε `{ $found }`
core-bib-abbreviation = η συντομογραφία `{ $name }` δεν έχει οριστεί
core-bib-ended-in-value = το αρχείο τελείωσε στη μέση μιας τιμής
