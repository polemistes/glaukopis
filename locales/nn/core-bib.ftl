# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = ein @string utan namn
core-bib-expected-found = venta `{ $expected }`, men fann `{ $found }`
core-bib-expected-end = venta `{ $expected }`, men fila slutta
core-bib-expected-brace = `@{ $kind }` blir ikkje følgd av `{"{"}` eller `(`
core-bib-comment-not-closed = ein kommentar som aldri blir lukka
core-bib-entry-not-closed = oppføringa `{ $key }` blir aldri lukka
core-bib-expected-field = i `{ $key }`: venta namnet på eit felt, men fann `{ $found }`
core-bib-field-without-value = i `{ $key }`: feltet `{ $field }` har ingen verdi
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = i `{ $key }`, feltet `{ $field }`: { $message }
core-bib-brace-not-closed = ein krøllparentes som aldri blir lukka
core-bib-quote-not-closed = eit hermeteikn som aldri blir lukka
core-bib-expected-value = venta ein verdi, men fann `{ $found }`
core-bib-abbreviation = forkortinga `{ $name }` er ikkje definert
core-bib-ended-in-value = fila slutta midt i ein verdi
