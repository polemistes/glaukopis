# The synchronization between the writer's devices, computers and phones, in
# English: its section in the settings, and what is told when a project was
# written in on two devices apart. See locales/README.md.

sync-title = Synkronisering
sync-about = Prosjekta, biblioteket, notatblokka og innstillingane dine blir synkroniserte mellom einingane.
# Under the heading on a device that takes the notes only, a phone.
sync-about-notes = Berre notatblokka blir synkronisert.

## Before it is on.

sync-server = Tenar
sync-computer-name = Namn på denne eininga
# The choice between the two ways of beginning, as a screen reader names it.
sync-how = Korleis denne eininga byrjar
sync-how-start = Byrj her
sync-how-join = Bruk ein kode
sync-password = Passordet til tenaren
sync-code = Kode
sync-start = Start synkronisering
sync-starting = Startar …
sync-join = Bli med
sync-joining = Blir med …
sync-unreachable = Tenaren kunne ikkje nåast.

## While it is on.

sync-working = Synkroniserer …
# $when is how long ago, as "just now", "3 minutes ago" or "12 March".
sync-last = Sist synkronisert { $when }
sync-never = Ikkje synkronisert enno
sync-offline = Tenaren kan ikkje nåast. Det som blir skrive her, blir teke vare på og sendt når det lèt seg gjere.
sync-refused = Synkroniseringa har stansa på denne eininga
# The line over the notes of a phone whose app is older than the form of something that is synchronized: the synchronization has stopped on it until the app is updated. The words are the owner's, and the core says the same in the settings (core-sync-update-needed).
sync-outdated = Oppdatering trengst for synkronisering.
sync-now = Synkroniser no
sync-computers = Einingar
sync-this-computer = { $name } (denne eininga)
# $when is how long ago, as "just now", "3 minutes ago" or "12 March".
sync-seen = Sist sett { $when }
sync-computers-unread = Tenaren kunne ikkje spørjast om kva einingar det finst.
sync-add = Legg til ei eining …
# $join is the name of the choice the other device makes, shown in italics; $until is a time of day.
sync-code-hint = Skriv inn koden på den andre eininga, med { $join } under Synkronisering i innstillingane der. Den kan brukast éin gong, til klokka { $until }.
sync-code-failed = Det kunne ikkje lagast nokon kode.
sync-rename-title = Gi eininga nytt namn
sync-remove-title = Fjerne «{ $name }»?
sync-remove-message = Den blir ikkje synkronisert lenger. Det som er på den, blir verande der.
# $why is what went wrong, a sentence of its own.
sync-remove-failed = «{ $name }» kunne ikkje fjernast. { $why }
sync-stop = Slutt å synkronisere på denne eininga
sync-stop-title = Slutte å synkronisere på denne eininga?
sync-stop-message = Det som er på denne eininga, blir verande her slik det er. Det som blir skrive på dei andre einingane dine, kjem ikkje lenger hit, og det som blir skrive her, går ikkje lenger til dei.
sync-stop-message-alone = Det som er på denne eininga, blir verande her slik det er. Den er den einaste eininga som blir synkronisert, så ingenting blir att på tenaren.
# Where the device that stops is the last, and takes the notes only, a phone: what the server keeps of the rest goes too.
sync-stop-message-alone-notes = Det som er på denne eininga, blir verande her slik det er. Den er den einaste eininga som blir synkronisert, så ingenting blir att på tenaren. Prosjekta dine og filene i biblioteket er ikkje på denne eininga: det tenaren har av dei, blir sletta.
sync-stop-confirm = Slutt å synkronisere
sync-stop-failed = Synkroniseringa kunne ikkje stansast

## Written apart.

sync-apart = «{ $name }» vart skrive i på to einingar medan dei var utan kontakt med kvarandre.
sync-apart-show = Vis endringane
sync-apart-no-history = Historikken til prosjektet blir ikkje teken vare på, så endringane kan ikkje visast. Prosjektet slik det var før, ligg mellom dei tidlegare versjonane.
sync-apart-earlier = Tidlegare versjonar
# The moment the review of such a project goes from, as the review names it: Since “the devices met”.
sync-apart-moment = einingane møttest
