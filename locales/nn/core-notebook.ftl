# What the core says of the notebook, in English.
# See locales/README.md.

core-notebook-reading = kunne ikkje lese notatblokka
core-notebook-picture-too-large = eit bilete gitt til notatblokka er større enn { $most } MB
# Of a note written in a window of its own (record 0109).
core-notebook-note-empty = eit tomt notat blir ikkje sendt
core-notebook-note-too-large = teksten i notatet er større enn { $most } MB
core-notebook-file-too-large = { $name } er større enn { $most } MB
# What was handed over by another app on a phone held neither words nor files; said after other words, so it begins with a small letter.
core-notebook-shared-empty = ingenting vart delt
# A file another app handed over could not be read from it; $name is what the other app calls the file.
core-notebook-shared-unread = { $name } kunne ikkje lesast
