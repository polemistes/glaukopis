# What the core says of project files (ADR 0036), in English.
# See locales/README.md.

core-projectfile-not-one = Dette er ikkje ei prosjektfil frå Glaukopis.
# $format is a number: the form of the file, which this version does not know.
core-projectfile-later = Denne prosjektfila er skriven av ein nyare versjon av Glaukopis (form { $format }). Oppdater Glaukopis for å opne den.
core-projectfile-no-document = Prosjektfila inneheld ikkje noko prosjekt.
core-projectfile-unreadable = Prosjektfila kan ikkje lesast: { $error }
core-projectfile-unwritable = Prosjektfila kunne ikkje skrivast: { $error }
# $name is the name of a part of the file.
core-projectfile-too-large = Ein del av prosjektfila er for stor: { $name }

## What was being done when the system said no, shown before what it said.

core-projectfile-reading = kunne ikkje lese prosjektfila
