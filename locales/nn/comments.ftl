# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Kommentarar
comments-between = Mellom kartet og kommentarane
comments-comment-on = Kommenter …
comments-comment = Kommenter
comments-write = Skriv ein kommentar. Enter sender han; Shift+Enter gir ny linje.
# $name: the element the comment is on.
comments-on = Til «{ $name }»
comments-answer = Svar …
comments-which = Kva kommentarar som blir viste
comments-open = { $count ->
    [0] Opne
   *[other] Opne ({ $count })
}
comments-settled = { $count ->
    [0] Avgjorde
   *[other] Avgjorde ({ $count })
}
comments-all = Alle
comments-none = Ingen kommentarar enno
comments-none-detail = Merk noko tekst og trykk Ctrl+Alt+C, eller vel Kommenter … i menyen til eit element. Ein kommentar er aldri ein del av teksten.
comments-none-of-these = Ingen av desse.
comments-settle = Avgjer tråden
comments-reopen = Opne tråden att
comments-edit = Endre
comments-edited = endra
comments-someone = Nokon
comments-note-deleted = Merknaden vart sletta
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Trykk for å gå til elementet; trykk to gonger for å skrive i det
comments-mark = { $count ->
    [one] Éin open kommentar
   *[other] { $count } opne kommentarar
}
comments-show-cards = Vis kvar kommentar under elementet sitt
comments-mark-hint = { $count ->
    [one] Éin open kommentar: trykk for å vise han under elementet, eller gøyme han
   *[other] { $count } opne kommentarar: trykk for å vise dei under elementet, eller gøyme dei
}
