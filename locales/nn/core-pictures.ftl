# What the core says of the store of pictures, in English.
# See locales/README.md.

core-pictures-not-a-picture = fila er ikkje eit bilete av ein type som kan brukast: PNG, JPEG, SVG, GIF, WebP, TIFF eller BMP
core-pictures-unreadable = biletet kunne ikkje lesast: { $error }
core-pictures-not-as-asked = det som kom, er ikkje biletet det vart bede om
core-pictures-too-large = biletet er større enn { $most } MB, som er det meste eit bilete kan vere
core-pictures-not-whole = biletet kom ikkje heilt fram
# Shown after "not found: ".
core-pictures-the-picture = biletet
# What a picture that came without a name is called, before the ending of
# its file: "picture.png".
core-pictures-unnamed = bilete

# A simple image editor (docs/plans/a-simple-image-editor.md).
# Put before the ending of a copy's name: "plate (edited).jpg", "plate (edited 2).jpg".
core-pictures-edited = redigert
# Likewise: "plate (smaller).jpg".
core-pictures-smaller = mindre
core-pictures-not-editable = ei teikning har ingen pikslar å redigere
core-pictures-nothing-changed = ingenting vart endra
