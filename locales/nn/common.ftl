## How long ago something was: "Changed { $ago }".

time-just-now = nettopp
time-minutes-ago = { $count ->
    [one] for eitt minutt sidan
   *[other] for { $count } minutt sidan
}
time-hours-ago = { $count ->
    [one] for ein time sidan
   *[other] for { $count } timar sidan
}
time-yesterday = i går
time-days-ago = for { $count } dagar sidan
