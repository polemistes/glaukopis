# The languages of a map and of a project: the dialog opened from the menu
# of a map (ADR 0020).

languages-menu = Språk …
languages-dialog = Språk
languages-dialog-subtitle = Språket i dette kartet, og i karta som kjem
languages-map = Språket i dette kartet
# What follows from the language of a map: the words its document prints in
# words of its own, the dictionary of its spelling, the quotation marks of a mention.
languages-map-hint = Avgjer kva ord dokumentet skriv ut på eiga hand, som «Notar» og «Figur»; kva ordbok stavinga blir kontrollert mot; og kva hermeteikn eit omtala ord står i.
# A map that was given no language is printed in English.
languages-map-none = Ikkje oppgitt (engelsk)
languages-project = Språket i nye kart i dette prosjektet
languages-project-hint = Det eit kart som blir laga i dette prosjektet, blir skrive på, for alle prosjektet er delt med. Eit kart som blir laga av eit dokument, held på språket i dokumentet. Kvart kart kan få eit anna ovanfor.
# Where the project chooses none, the settings' language of new texts holds; it is named.
languages-project-settings = Som i innstillingane ({ $language })
