# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Comentarios
comments-between = Entre el mapa y los comentarios
comments-comment-on = Comentar…
comments-comment = Comentar
comments-write = Escriba un comentario. Intro lo envía; Mayús+Intro pasa a una línea nueva.
# $name: the element the comment is on.
comments-on = Sobre «{ $name }»
comments-answer = Responder…
comments-which = Qué comentarios se muestran
comments-open = { $count ->
    [0] Abiertos
   *[other] Abiertos ({ $count })
}
comments-settled = { $count ->
    [0] Resueltos
   *[other] Resueltos ({ $count })
}
comments-all = Todos
comments-none = Aún no hay comentarios
comments-none-detail = Seleccione un texto y pulse Ctrl+Alt+C, o elija Comentar… en el menú de un elemento. Un comentario nunca forma parte del texto.
comments-none-of-these = Ninguno de estos.
comments-settle = Dar el hilo por resuelto
comments-reopen = Volver a abrir el hilo
comments-edit = Cambiar
comments-edited = cambiado
comments-someone = Alguien
comments-note-deleted = La nota se eliminó
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Pulse para ir al elemento; pulse dos veces para escribir en él
comments-mark = { $count ->
    [one] Un comentario abierto
    [many] { $count } de comentarios abiertos
   *[other] { $count } comentarios abiertos
}
comments-show-cards = Mostrar cada comentario bajo su elemento
comments-mark-hint = { $count ->
    [one] Un comentario abierto: pulse para mostrarlo bajo el elemento, o para ocultarlo
    [many] { $count } de comentarios abiertos: pulse para mostrarlos bajo el elemento, o para ocultarlos
   *[other] { $count } comentarios abiertos: pulse para mostrarlos bajo el elemento, o para ocultarlos
}
