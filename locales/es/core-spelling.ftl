# What the core says of spelling, in English. See locales/README.md.

# $name is the name of the dictionary's files: nb_NO. $message says why.
spelling-unreadable = No se pudo leer el diccionario { $name }: { $message }
spelling-encoding = El diccionario { $name } está escrito en una codificación que no se puede leer.
# Stands after "not found:". $language is the language of a map: nb, en-GB.
spelling-dictionary-for = un diccionario para «{ $language }»
spelling-not-a-word = «{ $word }» no se puede añadir a sus palabras.
spelling-not-a-language = No se pueden guardar palabras propias para «{ $language }».
