# What the core says of project files (ADR 0036), in English.
# See locales/README.md.

core-projectfile-not-one = Esto no es un archivo de proyecto de Glaukopis.
# $format is a number: the form of the file, which this version does not know.
core-projectfile-later = Este archivo de proyecto lo escribió una versión posterior de Glaukopis (formato { $format }). Actualice Glaukopis para abrirlo.
core-projectfile-no-document = El archivo de proyecto no contiene ningún proyecto.
core-projectfile-unreadable = No se puede leer el archivo de proyecto: { $error }
core-projectfile-unwritable = No se pudo escribir el archivo de proyecto: { $error }
# $name is the name of a part of the file.
core-projectfile-too-large = Una parte del archivo de proyecto es demasiado grande: { $name }

## What was being done when the system said no, shown before what it said.

core-projectfile-reading = al leer el archivo de proyecto
