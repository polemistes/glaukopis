# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = un @string sin nombre
core-bib-expected-found = se esperaba `{ $expected }` pero se encontró `{ $found }`
core-bib-expected-end = se esperaba `{ $expected }` pero el archivo terminó
core-bib-expected-brace = a `@{ $kind }` no le sigue `{"{"}` ni `(`
core-bib-comment-not-closed = un comentario que nunca se cierra
core-bib-entry-not-closed = la entrada `{ $key }` nunca se cierra
core-bib-expected-field = en `{ $key }`: se esperaba el nombre de un campo pero se encontró `{ $found }`
core-bib-field-without-value = en `{ $key }`: el campo `{ $field }` no tiene valor
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = en `{ $key }`, campo `{ $field }`: { $message }
core-bib-brace-not-closed = una llave que nunca se cierra
core-bib-quote-not-closed = unas comillas que nunca se cierran
core-bib-expected-value = se esperaba un valor pero se encontró `{ $found }`
core-bib-abbreviation = la abreviatura `{ $name }` no está definida
core-bib-ended-in-value = el archivo terminó en medio de un valor
