# What the core says of the store of pictures, in English.
# See locales/README.md.

core-pictures-not-a-picture = filen är inte en bild av ett slag som kan användas: PNG, JPEG, SVG, GIF, WebP, TIFF eller BMP
core-pictures-unreadable = bilden kunde inte läsas: { $error }
core-pictures-not-a-name = detta namnger ingen bild
core-pictures-not-as-asked = det som kom är inte den bild som bads om
core-pictures-needs-name = en bild måste heta något
core-pictures-too-large = bilden är större än { $most } MB, vilket är det mesta en bild får vara
core-pictures-not-whole = bilden kom inte fram hel
# Shown after "not found: ".
core-pictures-the-picture = bilden
# What a picture that came without a name is called, before the ending of
# its file: "picture.png".
core-pictures-unnamed = bild
