# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = en @string utan namn
core-bib-expected-found = väntade `{ $expected }` men fann `{ $found }`
core-bib-expected-end = väntade `{ $expected }` men filen tog slut
core-bib-expected-brace = `@{ $kind }` följs inte av `{"{"}` eller `(`
core-bib-comment-not-closed = en kommentar som aldrig avslutas
core-bib-entry-not-closed = posten `{ $key }` avslutas aldrig
core-bib-expected-field = i `{ $key }`: väntade ett fältnamn men fann `{ $found }`
core-bib-field-without-value = i `{ $key }`: fältet `{ $field }` har inget värde
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = i `{ $key }`, fältet `{ $field }`: { $message }
core-bib-brace-not-closed = en klammer som aldrig stängs
core-bib-quote-not-closed = ett citationstecken som aldrig stängs
core-bib-expected-value = väntade ett värde men fann `{ $found }`
core-bib-abbreviation = förkortningen `{ $name }` är inte definierad
core-bib-ended-in-value = filen tog slut mitt i ett värde
