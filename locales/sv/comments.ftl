# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Kommentarer
comments-between = Mellan kartan och kommentarerna
comments-comment-on = Kommentera…
comments-comment = Kommentera
comments-write = Skriv en kommentar. Retur skickar den; Skift+Retur ger ny rad.
# $name: the element the comment is on.
comments-on = Till ”{ $name }”
comments-answer = Svara…
comments-which = Vilka kommentarer som visas
comments-open = { $count ->
    [0] Öppna
   *[other] Öppna ({ $count })
}
comments-settled = { $count ->
    [0] Avgjorda
   *[other] Avgjorda ({ $count })
}
comments-all = Alla
comments-none = Inga kommentarer än
comments-none-detail = Markera lite text och tryck Ctrl+Alt+C, eller välj Kommentera… i ett elements meny. En kommentar är aldrig en del av texten.
comments-none-of-these = Ingen av dessa.
comments-settle = Avgör tråden
comments-reopen = Öppna tråden igen
comments-edit = Ändra
comments-edited = ändrad
comments-someone = Någon
comments-note-deleted = Anteckningen togs bort
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Tryck för att gå till elementet; tryck två gånger för att skriva i det
comments-mark = { $count ->
    [one] En öppen kommentar
   *[other] { $count } öppna kommentarer
}
comments-show-cards = Visa varje kommentar under sitt element
comments-mark-hint = { $count ->
    [one] En öppen kommentar: tryck för att visa den under elementet, eller dölja den
   *[other] { $count } öppna kommentarer: tryck för att visa dem under elementet, eller dölja dem
}
