# The kinds of elements that make a document, which come with the
# application (ADR 0038): what each is called in the kind menu and on the
# label of an element. The core has the same kinds, with their looks.

parts-group-front = Inledande delar
parts-group-back = Avslutande delar
parts-group-cover = Omslag
parts-more = Mer…

# The bases.
parts-front-section = Inledande avsnitt
parts-back-section = Avslutande avsnitt
parts-own-page = Egen sida
parts-cover = Omslag

# Front matter.
parts-abstract = Sammanfattning
parts-dedication = Dedikation
parts-epigraph = Motto
parts-copyright = Copyrightsida
parts-foreword = Företal
parts-preface = Förord
parts-cast = Rollista
parts-setting = Plats och tid
parts-standfirst = Ingress

# Back matter.
parts-acknowledgements = Tack
parts-appendix = Appendix
parts-afterword = Efterord
parts-glossary = Ordförklaringar
parts-about-the-author = Om författaren
parts-signature = Underskrift

# The cover.
parts-blurb = Baksidestext

# On the label of a second element of a kind a document has one of.
parts-doubled = Skrivs inte ut: ett annat element av det här slaget kommer först bland sina syskon.

## Where a kind puts an element in the document, where not where it stands.

parts-placed-front = Skrivs ut först, före resten på sin nivå
parts-placed-back = Skrivs ut sist, efter resten på sin nivå
parts-placed-cover = Skrivs bara ut på omslaget
parts-placed-none = Skrivs inte ut i dokumentet
parts-placed-front-short = skrivs ut först
parts-placed-back-short = skrivs ut sist
parts-placed-cover-short = bara på omslaget
parts-placed-none-short = skrivs inte ut
