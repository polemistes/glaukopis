# What the core says of the notebook, in English.
# See locales/README.md.

core-notebook-reading = läsningen av anteckningsboken
core-notebook-picture-too-large = en bild som getts till anteckningsboken är större än { $most } MB
# Of a note written in a window of its own (record 0109).
core-notebook-note-empty = en tom anteckning skickas inte
core-notebook-note-too-large = anteckningens text är större än { $most } MB
core-notebook-file-too-large = { $name } är större än { $most } MB
# What was handed over by another app on a phone held neither words nor files; said after other words, so it begins with a small letter.
core-notebook-shared-empty = ingenting delades
# A file another app handed over could not be read from it; $name is what the other app calls the file.
core-notebook-shared-unread = { $name } kunde inte läsas
