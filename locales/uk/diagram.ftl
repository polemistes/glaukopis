# A map as a diagram: the elements on a canvas, their branches and associations.

diagram-map = Мапа
diagram-idea = Назва
diagram-show-all = Показати всю мапу
diagram-tidy = Упорядкувати всю мапу
# The keys are shown as keys, where the variables stand.
diagram-hint-linking = Клацніть елемент, з яким повʼязати, або перейдіть до нього стрілками й натисніть { $enter } · { $esc } — вийти
diagram-link-handle = Перетягніть до іншого елемента, щоб повʼязати їх

## The view

diagram-view = Вигляд
diagram-zoom-out = Зменшити
diagram-zoom-in = Збільшити
diagram-actual-size = Справжній розмір
# How large the map is shown, in hundredths of its size.
diagram-zoom = { $percent }%

## Copying and pasting elements.

diagram-copied = { $count ->
    [one] Скопійовано { $count } елемент з усім, що під ним
    [few] Скопійовано { $count } елементи з усім, що під ними
    [many] Скопійовано { $count } елементів з усім, що під ними
   *[other] Скопійовано { $count } елемента з усім, що під ними
}
diagram-nothing-copied = Ще нічого не скопійовано
diagram-pasted-elsewhere = Скопійоване — з іншого проєкту, і сюди його вставити не можна
