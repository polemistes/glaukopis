# The languages of a map and of a project: the dialog opened from the menu
# of a map (ADR 0020).

languages-menu = Мови…
languages-dialog = Мови
languages-dialog-subtitle = Мова цієї мапи та наступних мап
languages-map = Мова цієї мапи
# What follows from the language of a map: the words its document prints in
# words of its own, the dictionary of its spelling, the quotation marks of a mention.
languages-map-hint = Визначає слова, які її документ друкує від себе, як-от «Примітки» та «Рисунок»; словник, за яким перевіряється правопис; і лапки, у яких стоїть згадка.
# A map that was given no language is printed in English.
languages-map-none = Не вказано (англійська)
languages-project = Мова нових мап у цьому проєкті
languages-project-hint = Якою мовою пишеться мапа, створена в цьому проєкті, для всіх, з ким проєкт спільний. Мапа, зроблена з документа, зберігає мову документа. Кожній мапі можна дати іншу мову вище.
# Where the project chooses none, the settings' language of new texts holds; it is named.
languages-project-settings = Як у налаштуваннях ({ $language })
