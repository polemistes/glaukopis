# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Коментарі
comments-between = Між мапою та коментарями
comments-comment-on = Коментувати…
comments-comment = Коментар
comments-write = Напишіть коментар. Enter надсилає його; Shift+Enter — новий рядок.
# $name: the element the comment is on.
comments-on = До «{ $name }»
comments-answer = Відповісти…
comments-which = Які коментарі показано
comments-open = { $count ->
    [0] Відкриті
   *[other] Відкриті ({ $count })
}
comments-settled = { $count ->
    [0] Вирішені
   *[other] Вирішені ({ $count })
}
comments-all = Усі
comments-none = Коментарів ще немає
comments-none-detail = Виділіть текст і натисніть Ctrl+Alt+C або виберіть «Коментувати…» у меню елемента. Коментар ніколи не є частиною тексту.
comments-none-of-these = Таких немає.
comments-settle = Вирішити гілку
comments-reopen = Відкрити гілку знову
comments-edit = Змінити
comments-edited = змінено
comments-someone = Хтось
comments-note-deleted = Нотатку видалено
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Натисніть, щоб перейти до елемента; натисніть двічі, щоб писати в ньому
comments-mark = { $count ->
    [one] { $count } відкритий коментар
    [few] { $count } відкриті коментарі
    [many] { $count } відкритих коментарів
   *[other] { $count } відкритого коментаря
}
comments-show-cards = Показати кожен коментар під його елементом
comments-mark-hint = { $count ->
    [one] { $count } відкритий коментар: натисніть, щоб показати його під елементом або сховати
    [few] { $count } відкриті коментарі: натисніть, щоб показати їх під елементом або сховати
    [many] { $count } відкритих коментарів: натисніть, щоб показати їх під елементом або сховати
   *[other] { $count } відкритого коментаря: натисніть, щоб показати їх під елементом або сховати
}
