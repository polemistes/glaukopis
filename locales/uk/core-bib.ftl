# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = @string без назви
core-bib-expected-found = очікувалося `{ $expected }`, а знайдено `{ $found }`
core-bib-expected-end = очікувалося `{ $expected }`, але файл закінчився
core-bib-expected-brace = після `@{ $kind }` немає `{"{"}` або `(`
core-bib-comment-not-closed = коментар, який ніде не закривається
core-bib-entry-not-closed = запис `{ $key }` ніде не закривається
core-bib-expected-field = у `{ $key }`: очікувалася назва поля, а знайдено `{ $found }`
core-bib-field-without-value = у `{ $key }`: поле `{ $field }` не має значення
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = у `{ $key }`, поле `{ $field }`: { $message }
core-bib-brace-not-closed = дужка, яка ніде не закривається
core-bib-quote-not-closed = лапки, які ніде не закриваються
core-bib-expected-value = очікувалося значення, а знайдено `{ $found }`
core-bib-abbreviation = скорочення `{ $name }` не визначено
core-bib-ended-in-value = файл закінчився посеред значення
