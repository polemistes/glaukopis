# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Комментарии
comments-between = Между картой и комментариями
comments-comment-on = Комментировать…
comments-comment = Комментировать
comments-write = Напишите комментарий. Enter отправляет его, Shift+Enter переносит строку.
# $name: the element the comment is on.
comments-on = К «{ $name }»
comments-answer = Ответить…
comments-which = Какие комментарии показывать
comments-open = { $count ->
    [0] Открытые
   *[other] Открытые ({ $count })
}
comments-settled = { $count ->
    [0] Закрытые
   *[other] Закрытые ({ $count })
}
comments-all = Все
comments-none = Комментариев пока нет
comments-none-detail = Выделите текст и нажмите Ctrl+Alt+C или выберите «Комментировать…» в меню элемента. Комментарий никогда не становится частью текста.
comments-none-of-these = Таких нет.
comments-settle = Закрыть обсуждение
comments-reopen = Открыть обсуждение снова
comments-edit = Изменить
comments-edited = изменён
comments-someone = Кто-то
comments-note-deleted = Запись удалена
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Нажмите, чтобы перейти к элементу; нажмите дважды, чтобы писать в нём
comments-mark = { $count ->
    [one] { $count } открытый комментарий
    [few] { $count } открытых комментария
    [many] { $count } открытых комментариев
   *[other] { $count } открытых комментария
}
comments-show-cards = Показывать каждый комментарий под его элементом
comments-mark-hint = { $count ->
    [one] { $count } открытый комментарий: нажмите, чтобы показать его под элементом или скрыть
    [few] { $count } открытых комментария: нажмите, чтобы показать их под элементом или скрыть
    [many] { $count } открытых комментариев: нажмите, чтобы показать их под элементом или скрыть
   *[other] { $count } открытых комментария: нажмите, чтобы показать их под элементом или скрыть
}
