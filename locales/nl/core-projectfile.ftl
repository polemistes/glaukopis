# What the core says of project files (ADR 0036), in English.
# See locales/README.md.

core-projectfile-not-one = Dit is geen projectbestand van Glaukopis.
# $format is a number: the form of the file, which this version does not know.
core-projectfile-later = Dit projectbestand is geschreven door een latere versie van Glaukopis (vorm { $format }). Werk Glaukopis bij om het te openen.
core-projectfile-no-document = Het projectbestand bevat geen project.
core-projectfile-unreadable = Het projectbestand kan niet worden gelezen: { $error }
core-projectfile-unwritable = Het projectbestand kon niet worden geschreven: { $error }
# $name is the name of a part of the file.
core-projectfile-too-large = Een deel van het projectbestand is te groot: { $name }

## What was being done when the system said no, shown before what it said.

core-projectfile-reading = het lezen van het projectbestand
