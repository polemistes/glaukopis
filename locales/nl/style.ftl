## The parts of a style, as the style editor tells them in words.

style-part-layout = Het geheel
style-part-text = Tekst
# A part that prints a word of the style's language: the term is its name in CSL.
style-part-term = Het woord voor ‘{ $term }’
# A part that prints words written into the style.
style-part-value = De woorden ‘{ $value }’
style-part-name = Hoe de namen worden geschreven
# The name is family or given, as CSL has them.
style-part-name-part = { $name ->
    [family] De achternaam
    [given] De voornaam
   *[other] De naam ‘{ $name }’
}
style-part-et-al = ‘et al.’
# The variables are one or more of those below: "the pages".
style-part-label = Het woord voor { $variables } (‘p.’, ‘red.’)
style-part-role = Het woord voor de rol (‘red.’, ‘vert.’)
style-part-substitute = Als die naam er niet is, in zijn plaats
# The name is day, month or year, as CSL has them, or part.
style-part-date-part = { $name ->
    [day] De dag
    [month] De maand
    [year] Het jaar
   *[other] De { $name }
}
style-part-group = Samen
style-part-choose = Een van deze
# The condition is made of those below.
style-part-if = Als { $condition }
style-part-else-if = Of anders, als { $condition }
style-part-else = Anders
# A name the style has, of a part of it (a macro) or of a variable it does not know.
style-quoted = ‘{ $text }’

## Words that join others: "the author, or else the editor", "a book or a chapter".
## The first may be a list of several, joined by commas.

style-or = { $first } of { $last }
style-and = { $first } en { $last }
style-or-else = { $first }, of anders { $last }

## When a part of a style is printed: "If the work is a book".

style-if-type = het werk { $types } is
style-if-has = het { $variables } heeft
style-if-lacks = het geen { $variables } heeft
style-if-numeric = { $variables } een getal is
style-if-uncertain = { $variables } onzeker is
# The places are pages, chapters, verses and the like; see style-locator.
style-if-locator = de geciteerde plaats { $locators } is
style-if-disambiguate = het anders voor een ander zou worden aangezien
style-if-always = altijd
style-if-none-holds = niets hiervan geldt: { $conditions }
# A kind of place that a citation points to, as CSL names it: page, chapter, verse,
# sub-verbo, and so on. English leaves the names as they are.
style-locator = een { $name }

## When a citation is printed, by where it stands among the others.

style-position-first = het voor het eerst wordt geciteerd
style-position-subsequent = het eerder is geciteerd
style-position-ibid = het hetzelfde is als de verwijzing ervoor
style-position-ibid-with-locator = het hetzelfde is als de verwijzing ervoor, op een andere plaats
style-position-near-note = het in een noot vlakbij is geciteerd

## How a part is set: "italic, in quotation marks, before “, ”".

style-form-italic = cursief
style-form-bold = vet
style-form-small-caps = klein kapitaal
style-form-underlined = onderstreept
style-form-quoted = tussen aanhalingstekens
# How the letters are set, as CSL names it; the words are that name with spaces for its dashes.
style-form-case = { $case ->
    [lowercase] kleine letters
    [uppercase] kapitalen
    [capitalize-first] eerste letter een hoofdletter
    [capitalize-all] elk woord een hoofdletter
    [sentence] zinshoofdletters
    [title] titelhoofdletters
   *[other] { $words }
}
style-form-raised = verhoogd
style-form-lowered = verlaagd
# The part comes after these words.
style-form-after = na ‘{ $text }’
# The part comes before these words.
style-form-before = voor ‘{ $text }’
style-form-between = met ‘{ $text }’ ertussen

