# A map as a diagram: the elements on a canvas, their branches and associations.

diagram-map = Mindmap
diagram-idea = Naam
diagram-new-here = Nieuw element hier
diagram-open-as-map = Als mindmap openen
diagram-show-all = De hele mindmap tonen
diagram-tidy = De hele mindmap opruimen
# The keys are shown as keys, where the variables stand.
diagram-hint-linking = Klik op het element om mee te verbinden, of ga ernaartoe met de pijltjes en druk op { $enter } · { $esc } om het te laten
diagram-show-under = Tonen wat eronder staat
diagram-hide-under = Verbergen wat eronder staat
diagram-link-handle = Sleep naar een ander element om ze te verbinden

## The view

diagram-view = Weergave
diagram-zoom-out = Uitzoomen
diagram-zoom-in = Inzoomen
diagram-actual-size = Ware grootte
# How large the map is shown, in hundredths of its size.
diagram-zoom = { $percent }%

## Copying and pasting elements.

diagram-copied = { $count ->
    [one] Eén element gekopieerd, met alles eronder
   *[other] { $count } elementen gekopieerd, met alles eronder
}
diagram-cut = { $count ->
    [one] Eén element is geknipt: het gaat naar waar je het plakt
   *[other] { $count } elementen zijn geknipt: ze gaan naar waar je ze plakt
}
diagram-paste-here = Hier plakken
diagram-nothing-copied = Er is nog niets gekopieerd
diagram-pasted-elsewhere = Wat is gekopieerd, is van een ander project en kan hier niet worden geplakt
