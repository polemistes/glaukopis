# What the core says of the store of pictures, in English.
# See locales/README.md.

core-pictures-not-a-picture = het bestand is geen afbeelding van een soort die kan worden gebruikt: PNG, JPEG, SVG, GIF, WebP, TIFF of BMP
core-pictures-unreadable = de afbeelding kon niet worden gelezen: { $error }
core-pictures-not-a-name = dit noemt geen afbeelding
core-pictures-not-as-asked = wat aankwam is niet de afbeelding waarom werd gevraagd
core-pictures-needs-name = een afbeelding moet een naam hebben
core-pictures-too-large = de afbeelding is groter dan { $most } MB, en groter mag een afbeelding niet zijn
core-pictures-not-whole = de afbeelding is niet heel aangekomen
# Shown after "not found: ".
core-pictures-the-picture = de afbeelding
# What a picture that came without a name is called, before the ending of
# its file: "picture.png".
core-pictures-unnamed = afbeelding
