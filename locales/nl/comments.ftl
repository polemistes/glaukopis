# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Opmerkingen
comments-between = Tussen de mindmap en de opmerkingen
comments-comment-on = Opmerking…
comments-comment = Opmerking
comments-write = Schrijf een opmerking. Enter verstuurt; Shift+Enter begint een nieuwe regel.
# $name: the element the comment is on.
comments-on = Bij ‘{ $name }’
comments-answer = Antwoorden…
comments-which = Welke opmerkingen worden getoond
comments-open = { $count ->
    [0] Open
   *[other] Open ({ $count })
}
comments-settled = { $count ->
    [0] Afgehandeld
   *[other] Afgehandeld ({ $count })
}
comments-all = Alle
comments-none = Nog geen opmerkingen
comments-none-detail = Selecteer wat tekst en druk op Ctrl+Alt+C, of kies Opmerking… in het menu van een element. Een opmerking wordt nooit deel van de tekst.
comments-none-of-these = Geen van deze.
comments-settle = De draad afhandelen
comments-reopen = De draad weer openen
comments-edit = Wijzigen
comments-edited = gewijzigd
comments-someone = Iemand
comments-note-deleted = De notitie is gewist
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Druk om naar het element te gaan; druk tweemaal om erin te schrijven
comments-mark = { $count ->
    [one] Eén open opmerking
   *[other] { $count } open opmerkingen
}
comments-show-cards = Elke opmerking onder haar element tonen
comments-mark-hint = { $count ->
    [one] Eén open opmerking: druk om haar onder het element te tonen, of te verbergen
   *[other] { $count } open opmerkingen: druk om ze onder het element te tonen, of te verbergen
}
