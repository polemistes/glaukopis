# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = een @string zonder naam
core-bib-expected-found = `{ $expected }` verwacht, maar `{ $found }` gevonden
core-bib-expected-end = `{ $expected }` verwacht, maar het bestand eindigde
core-bib-expected-brace = na `@{ $kind }` volgt geen `{"{"}` of `(`
core-bib-comment-not-closed = een commentaar dat nooit wordt gesloten
core-bib-entry-not-closed = het item `{ $key }` wordt nooit gesloten
core-bib-expected-field = in `{ $key }`: een veldnaam verwacht, maar `{ $found }` gevonden
core-bib-field-without-value = in `{ $key }`: het veld `{ $field }` heeft geen waarde
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = in `{ $key }`, veld `{ $field }`: { $message }
core-bib-brace-not-closed = een accolade die nooit wordt gesloten
core-bib-quote-not-closed = een aanhalingsteken dat nooit wordt gesloten
core-bib-expected-value = een waarde verwacht, maar `{ $found }` gevonden
core-bib-abbreviation = de afkorting `{ $name }` is niet gedefinieerd
core-bib-ended-in-value = het bestand eindigde midden in een waarde
