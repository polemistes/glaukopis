kinds-delete-message = { $count ->
    [0] Niciun element nu este de acest tip.
    [one] Singurul element care este de acest tip va fi fără tip.
    [few] Cele { $count } elemente care sunt de acest tip vor fi fără tip.
   *[other] Cele { $count } de elemente care sunt de acest tip vor fi fără tip.
}
