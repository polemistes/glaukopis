# The languages of a map and of a project: the dialog opened from the menu
# of a map (ADR 0020).

languages-menu = Limbi…
languages-dialog = Limbi
languages-dialog-subtitle = Limba acestei hărți și a hărților care vor veni
languages-map = Limba acestei hărți
# What follows from the language of a map: the words its document prints in
# words of its own, the dictionary of its spelling, the quotation marks of a mention.
languages-map-hint = Hotărăște cuvintele pe care documentul ei le tipărește de la sine, precum „Note” și „Figura”; dicționarul după care i se verifică ortografia; și ghilimelele între care stă o mențiune.
# A map that was given no language is printed in English.
languages-map-none = Nespusă (engleză)
languages-project = Limba hărților noi din acest proiect
languages-project-hint = În ce se scrie o hartă făcută în acest proiect, pentru toți cei cu care este partajat proiectul. O hartă făcută dintr-un document păstrează limba documentului. Fiecărei hărți i se poate da altă limbă mai sus.
# Where the project chooses none, the settings' language of new texts holds; it is named.
languages-project-settings = Ca în setări ({ $language })
