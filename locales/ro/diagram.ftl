# A map as a diagram: the elements on a canvas, their branches and associations.

diagram-map = Hartă
diagram-idea = Nume
diagram-new-loose = Element liber nou aici
diagram-new-loose-hint = Un gând care nu are încă loc
diagram-show-all = Arată toată harta
diagram-tidy = Ordonează toată harta
diagram-tidy-hint = Fiecare element se întoarce la locul lui automat
# The keys are shown as keys, where the variables stand.
diagram-hint-empty = { $tab } adaugă un element sub cel selectat · { $enter } adaugă unul alături · dublu clic pentru a scrie
diagram-hint-linking = Faceți clic pe elementul cu care să-l asociați, sau mergeți la el cu săgețile și apăsați { $enter } · { $esc } ca să renunțați
diagram-show-under = Arată ce este sub el
diagram-hide-under = Ascunde ce este sub el
diagram-link-handle = Trageți spre alt element ca să le asociați

## The view

diagram-view = Vedere
diagram-zoom-out = Micșorează
diagram-zoom-in = Mărește
diagram-actual-size = Mărimea reală
# How large the map is shown, in hundredths of its size.
diagram-zoom = { $percent }%

## Copying and pasting elements.

diagram-copied = { $count ->
    [one] Un element copiat, cu tot ce este sub el
    [few] { $count } elemente copiate, cu tot ce este sub ele
   *[other] { $count } de elemente copiate, cu tot ce este sub ele
}
diagram-nothing-copied = Nu este nimic copiat încă
diagram-pasted-elsewhere = Ce s-a copiat este din alt proiect și nu se poate lipi aici
