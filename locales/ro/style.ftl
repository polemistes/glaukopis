## The parts of a style, as the style editor tells them in words.

style-part-layout = Întregul
style-part-text = Text
# A part that prints a word of the style's language: the term is its name in CSL.
style-part-term = Cuvântul pentru „{ $term }”
# A part that prints words written into the style.
style-part-value = Cuvintele „{ $value }”
style-part-name = Cum se scriu numele
# The name is family or given, as CSL has them.
style-part-name-part = { $name ->
    [family] Numele de familie
    [given] Prenumele
   *[other] Numele „{ $name }”
}
style-part-et-al = „et al.”
# The variables are one or more of those below: "the pages".
style-part-label = Cuvântul dinaintea { $variables } („p.”, „ed.”)
style-part-role = Cuvântul pentru rol („ed.”, „trad.”)
style-part-substitute = Când nu există un asemenea nume, în locul lui
# The name is day, month or year, as CSL has them, or part.
style-part-date-part = { $name ->
    [day] Ziua
    [month] Luna
    [year] Anul
   *[other] Partea „{ $name }”
}
style-part-group = Împreună
style-part-choose = Una dintre acestea
# The condition is made of those below.
style-part-if = Dacă { $condition }
style-part-else-if = Altfel, dacă { $condition }
style-part-else = Altminteri
# A name the style has, of a part of it (a macro) or of a variable it does not know.
style-quoted = „{ $text }”

## Words that join others: "the author, or else the editor", "a book or a chapter".
## The first may be a list of several, joined by commas.

style-or = { $first } sau { $last }
style-and = { $first } și { $last }
style-or-else = { $first }, altfel { $last }

## When a part of a style is printed: "If the work is a book".

style-if-type = lucrarea este { $types }
style-if-has = are { $variables }
style-if-lacks = nu are { $variables }
style-if-numeric = { $variables } este un număr
style-if-uncertain = { $variables } este nesigur
# The places are pages, chapters, verses and the like; see style-locator.
style-if-locator = locul citat este { $locators }
style-if-disambiguate = altfel s-ar confunda cu alta
style-if-always = întotdeauna
style-if-none-holds = nimic din acestea nu este adevărat: { $conditions }
# A kind of place that a citation points to, as CSL names it: page, chapter, verse,
# sub-verbo, and so on. English leaves the names as they are.
style-locator = „{ $name }”

## When a citation is printed, by where it stands among the others.

style-position-first = este citată pentru prima dată
style-position-subsequent = a mai fost citată
style-position-ibid = este aceeași cu citarea dinainte
style-position-ibid-with-locator = este aceeași cu citarea dinainte, în alt loc
style-position-near-note = a fost citată într-o notă din apropiere

