# A part of a macro: a part of the style that is used in several places.
style-part-shared = { $count ->
    [one] Aceasta aparține de „{ $macro }”, care se folosește într-un loc. O modificare aici se vede acolo.
    [few] Aceasta aparține de „{ $macro }”, care se folosește în { $count } locuri. O modificare aici se vede în toate.
   *[other] Aceasta aparține de „{ $macro }”, care se folosește în { $count } de locuri. O modificare aici se vede în toate.
}
