# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Comentarii
comments-between = Între hartă și comentarii
comments-comment-on = Comentează…
comments-comment = Comentează
comments-write = Scrieți un comentariu. Enter îl trimite; Shift+Enter începe un rând nou.
# $name: the element the comment is on.
comments-on = La „{ $name }”
comments-answer = Răspunde…
comments-which = Ce comentarii se arată
comments-open = { $count ->
    [0] Deschise
   *[other] Deschise ({ $count })
}
comments-settled = { $count ->
    [0] Rezolvate
   *[other] Rezolvate ({ $count })
}
comments-all = Toate
comments-none = Niciun comentariu încă
comments-none-detail = Selectați un text și apăsați Ctrl+Alt+C, sau alegeți Comentează… din meniul unui element. Un comentariu nu face niciodată parte din text.
comments-none-of-these = Niciunul dintre acestea.
comments-settle = Rezolvă firul
comments-reopen = Deschide firul din nou
comments-edit = Modifică
comments-edited = modificat
comments-someone = Cineva
comments-note-deleted = Nota a fost ștearsă
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Apăsați ca să mergeți la element; apăsați de două ori ca să scrieți în el
comments-mark = { $count ->
    [one] Un comentariu deschis
    [few] { $count } comentarii deschise
   *[other] { $count } de comentarii deschise
}
comments-show-cards = Arată fiecare comentariu sub elementul lui
comments-mark-hint = { $count ->
    [one] Un comentariu deschis: apăsați ca să-l arătați sub element sau ca să-l ascundeți
    [few] { $count } comentarii deschise: apăsați ca să le arătați sub element sau ca să le ascundeți
   *[other] { $count } de comentarii deschise: apăsați ca să le arătați sub element sau ca să le ascundeți
}
