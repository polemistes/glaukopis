## How long ago something was: "Changed { $ago }".

time-just-now = chiar acum
time-minutes-ago = { $count ->
    [one] acum un minut
    [few] acum { $count } minute
   *[other] acum { $count } de minute
}
time-hours-ago = { $count ->
    [one] acum o oră
    [few] acum { $count } ore
   *[other] acum { $count } de ore
}
time-yesterday = ieri
time-days-ago = { $count ->
    [one] acum o zi
    [few] acum { $count } zile
   *[other] acum { $count } de zile
}
