# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = un @string fără nume
core-bib-expected-found = se aștepta `{ $expected }`, dar s-a găsit `{ $found }`
core-bib-expected-end = se aștepta `{ $expected }`, dar fișierul s-a terminat
core-bib-expected-brace = `@{ $kind }` nu este urmat de `{"{"}` sau `(`
core-bib-comment-not-closed = un comentariu care nu se închide niciodată
core-bib-entry-not-closed = intrarea `{ $key }` nu se închide niciodată
core-bib-expected-field = în `{ $key }`: se aștepta numele unui câmp, dar s-a găsit `{ $found }`
core-bib-field-without-value = în `{ $key }`: câmpul `{ $field }` nu are valoare
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = în `{ $key }`, câmpul `{ $field }`: { $message }
core-bib-brace-not-closed = o acoladă care nu se închide niciodată
core-bib-quote-not-closed = o ghilimea care nu se închide niciodată
core-bib-expected-value = se aștepta o valoare, dar s-a găsit `{ $found }`
core-bib-abbreviation = abrevierea `{ $name }` nu este definită
core-bib-ended-in-value = fișierul s-a terminat în mijlocul unei valori
