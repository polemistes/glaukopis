## How long ago something was: "Changed { $ago }".

time-just-now = agora mesmo
time-minutes-ago = { $count ->
    [one] há um minuto
    [many] há { $count } minutos
   *[other] há { $count } minutos
}
time-hours-ago = { $count ->
    [one] há uma hora
    [many] há { $count } horas
   *[other] há { $count } horas
}
time-yesterday = ontem
time-days-ago = { $count ->
    [one] há { $count } dia
    [many] há { $count } dias
   *[other] há { $count } dias
}
