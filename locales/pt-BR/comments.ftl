# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Comentários
comments-between = Entre o mapa e os comentários
comments-comment-on = Comentar…
comments-comment = Comentar
comments-write = Escreva um comentário. Enter envia; Shift+Enter abre uma nova linha.
# $name: the element the comment is on.
comments-on = Sobre “{ $name }”
comments-answer = Responder…
comments-which = Quais comentários são mostrados
comments-open = { $count ->
    [0] Abertos
   *[other] Abertos ({ $count })
}
comments-settled = { $count ->
    [0] Resolvidos
   *[other] Resolvidos ({ $count })
}
comments-all = Todos
comments-none = Ainda não há comentários
comments-none-detail = Selecione um trecho e pressione Ctrl+Alt+C, ou escolha Comentar… no menu de um elemento. Um comentário nunca faz parte do texto.
comments-none-of-these = Nenhum destes.
comments-settle = Resolver a discussão
comments-reopen = Reabrir a discussão
comments-edit = Alterar
comments-edited = alterado
comments-someone = Alguém
comments-note-deleted = A nota foi excluída
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Clique para ir ao elemento; clique duas vezes para escrever nele
comments-mark = { $count ->
    [one] Um comentário aberto
    [many] { $count } comentários abertos
   *[other] { $count } comentários abertos
}
comments-show-cards = Mostrar cada comentário sob o seu elemento
comments-mark-hint = { $count ->
    [one] Um comentário aberto: clique para mostrá-lo sob o elemento, ou escondê-lo
    [many] { $count } comentários abertos: clique para mostrá-los sob o elemento, ou escondê-los
   *[other] { $count } comentários abertos: clique para mostrá-los sob o elemento, ou escondê-los
}
