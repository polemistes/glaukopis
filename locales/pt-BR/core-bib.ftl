# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = um @string sem nome
core-bib-expected-found = esperava-se `{ $expected }`, mas encontrou-se `{ $found }`
core-bib-expected-end = esperava-se `{ $expected }`, mas o arquivo terminou
core-bib-expected-brace = `@{ $kind }` não é seguido de `{"{"}` nem de `(`
core-bib-comment-not-closed = um comentário que nunca é fechado
core-bib-entry-not-closed = a entrada `{ $key }` nunca é fechada
core-bib-expected-field = em `{ $key }`: esperava-se o nome de um campo, mas encontrou-se `{ $found }`
core-bib-field-without-value = em `{ $key }`: o campo `{ $field }` não tem valor
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = em `{ $key }`, campo `{ $field }`: { $message }
core-bib-brace-not-closed = uma chave que nunca é fechada
core-bib-quote-not-closed = aspas que nunca são fechadas
core-bib-expected-value = esperava-se um valor, mas encontrou-se `{ $found }`
core-bib-abbreviation = a abreviatura `{ $name }` não está definida
core-bib-ended-in-value = o arquivo terminou no meio de um valor
