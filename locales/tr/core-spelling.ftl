# What the core says of spelling, in English. See locales/README.md.

# $name is the name of the dictionary's files: nb_NO. $message says why.
spelling-unreadable = { $name } sözlüğü okunamadı: { $message }
spelling-encoding = { $name } sözlüğü okunamayan bir kodlamayla yazılmış.
# Stands after "not found:". $language is the language of a map: nb, en-GB.
spelling-dictionary-for = “{ $language }” için bir sözlük
spelling-not-a-word = “{ $word }” sözcüklerinize eklenemez.
spelling-not-a-language = “{ $language }” için kendi sözcükleriniz tutulamaz.
