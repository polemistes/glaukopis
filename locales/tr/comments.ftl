comments-none-of-these = Bunlardan hiçbiri yok.
comments-settle = Diziyi çözüldü say
comments-reopen = Diziyi yeniden aç
comments-edit = Değiştir
comments-edited = değiştirildi
comments-someone = Biri
comments-note-deleted = Not silindi
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Öğeye gitmek için basın; içine yazmak için iki kez basın
comments-mark = { $count ->
    [one] Bir açık yorum
   *[other] { $count } açık yorum
}
comments-show-cards = Her yorumu kendi öğesinin altında göster
comments-mark-hint = { $count ->
    [one] Bir açık yorum: öğenin altında göstermek ya da gizlemek için basın
