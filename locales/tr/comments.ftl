# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Yorumlar
comments-between = Harita ile yorumlar arası
comments-comment-on = Yorum yap…
comments-comment = Yorum
comments-write = Bir yorum yazın. Enter gönderir; Shift+Enter yeni satır açar.
# $name: the element the comment is on.
comments-on = “{ $name }” üzerine
comments-answer = Yanıtla…
comments-which = Hangi yorumlar gösterilsin
comments-open = { $count ->
    [0] Açık
   *[other] Açık ({ $count })
}
comments-settled = { $count ->
    [0] Çözülmüş
   *[other] Çözülmüş ({ $count })
}
comments-all = Tümü
comments-none = Henüz yorum yok
