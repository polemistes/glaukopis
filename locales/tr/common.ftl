## How long ago something was: "Changed { $ago }".

time-just-now = az önce
time-minutes-ago = { $count ->
    [one] bir dakika önce
   *[other] { $count } dakika önce
}
time-hours-ago = { $count ->
    [one] bir saat önce
   *[other] { $count } saat önce
}
time-yesterday = dün
time-days-ago = { $count } gün önce
