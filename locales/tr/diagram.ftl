# A map as a diagram: the elements on a canvas, their branches and associations.

diagram-map = Harita
diagram-idea = Ad
diagram-new-loose = Buraya yeni serbest öğe
diagram-new-loose-hint = Henüz yeri olmayan bir düşünce
diagram-show-all = Bütün haritayı göster
diagram-tidy = Bütün haritayı düzenle
diagram-tidy-hint = Her öğe kendiliğinden aldığı yere geri döner
# The keys are shown as keys, where the variables stand.
diagram-hint-empty = { $tab } seçili öğenin altına bir öğe ekler · { $enter } yanına bir öğe ekler · yazmak için çift tıklayın
diagram-hint-linking = İlişkilendirilecek öğeye tıklayın ya da oklarla ona gidip { $enter } tuşuna basın · çıkmak için { $esc }
diagram-show-under = Altındakileri göster
diagram-hide-under = Altındakileri gizle
diagram-link-handle = İlişkilendirmek için başka bir öğeye sürükleyin

## The view

diagram-view = Görünüm
diagram-zoom-out = Uzaklaştır
diagram-zoom-in = Yakınlaştır
diagram-actual-size = Gerçek boyut
# How large the map is shown, in hundredths of its size.
diagram-zoom = %{ $percent }

## Copying and pasting elements.

diagram-copied = { $count ->
    [one] Bir öğe, altındakilerin hepsiyle birlikte kopyalandı
   *[other] { $count } öğe, altındakilerin hepsiyle birlikte kopyalandı
}
diagram-nothing-copied = Henüz hiçbir şey kopyalanmadı
diagram-pasted-elsewhere = Kopyalanan başka bir projeye ait; buraya yapıştırılamaz
