# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = adı olmayan bir @string
core-bib-expected-found = `{ $expected }` bekleniyordu, ama bulunan: `{ $found }`
core-bib-expected-end = `{ $expected }` bekleniyordu, ama dosya bitti
core-bib-expected-brace = `@{ $kind }` ardından `{"{"}` ya da `(` gelmiyor
core-bib-comment-not-closed = hiç kapanmayan bir yorum
core-bib-entry-not-closed = `{ $key }` girdisi hiç kapanmıyor
core-bib-expected-field = `{ $key }` içinde: bir alan adı bekleniyordu, ama bulunan: `{ $found }`
core-bib-field-without-value = `{ $key }` içinde: `{ $field }` alanının değeri yok
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = `{ $key }`, `{ $field }` alanı: { $message }
core-bib-brace-not-closed = hiç kapanmayan bir küme parantezi
core-bib-quote-not-closed = hiç kapanmayan bir tırnak işareti
core-bib-expected-value = bir değer bekleniyordu, ama bulunan: `{ $found }`
core-bib-abbreviation = `{ $name }` kısaltması tanımlı değil
core-bib-ended-in-value = dosya bir değerin ortasında bitti
