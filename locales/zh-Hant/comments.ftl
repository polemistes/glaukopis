# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = 註解
comments-between = 心智圖與註解之間
comments-comment-on = 加註解…
comments-comment = 註解
comments-write = 寫一則註解。按 Enter 送出；Shift+Enter 換行。
# $name: the element the comment is on.
comments-on = 關於「{ $name }」
comments-answer = 回覆…
comments-which = 顯示哪些註解
comments-open = { $count ->
    [0] 未解決
   *[other] 未解決（{ $count }）
}
comments-settled = { $count ->
    [0] 已解決
   *[other] 已解決（{ $count }）
}
comments-all = 全部
comments-none = 尚無註解
comments-none-detail = 選取一些文字後按 Ctrl+Alt+C，或從元素的選單選「加註解…」。註解永遠不是文字的一部分。
comments-none-of-these = 沒有這類註解。
comments-settle = 解決此討論串
comments-reopen = 重新開啟討論串
comments-edit = 修改
comments-edited = 已修改
comments-someone = 某人
comments-note-deleted = 這則回覆已刪除
# On an element in the diagram, and in the margin of the text.
comments-element-hint = 按下前往該元素；按兩下在其中寫作
comments-mark = { $count ->
   *[other] { $count } 則未解決的註解
}
comments-show-cards = 在每個元素下方顯示其所有註解
comments-mark-hint = { $count ->
   *[other] { $count } 則未解決的註解：按下在元素下方顯示或隱藏
}
