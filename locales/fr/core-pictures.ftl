# What the core says of the store of pictures, in English.
# See locales/README.md.

core-pictures-not-a-picture = le fichier n’est pas une image d’un type utilisable : PNG, JPEG, SVG, GIF, WebP, TIFF ou BMP
core-pictures-unreadable = l’image n’a pas pu être lue : { $error }
core-pictures-not-a-name = ceci ne nomme pas une image
core-pictures-not-as-asked = ce qui est arrivé n’est pas l’image demandée
core-pictures-needs-name = une image doit avoir un nom
core-pictures-too-large = l’image fait plus de { $most } Mo, le plus qu’une image puisse faire
core-pictures-not-whole = l’image n’est pas arrivée entière
# Shown after "not found: ".
core-pictures-the-picture = l’image
# What a picture that came without a name is called, before the ending of
# its file: "picture.png".
core-pictures-unnamed = image
