# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Commentaires
comments-between = Entre la carte et les commentaires
comments-comment-on = Commenter…
comments-comment = Commenter
comments-write = Écrivez un commentaire. Entrée l’envoie ; Maj+Entrée va à la ligne.
# $name: the element the comment is on.
comments-on = Sur « { $name } »
comments-answer = Répondre…
comments-which = Quels commentaires sont affichés
comments-open = { $count ->
    [0] Ouverts
   *[other] Ouverts ({ $count })
}
comments-settled = { $count ->
    [0] Clos
   *[other] Clos ({ $count })
}
comments-all = Tous
comments-none = Pas encore de commentaires
comments-none-detail = Sélectionnez du texte et appuyez sur Ctrl+Alt+C, ou choisissez Commenter… dans le menu d’un élément. Un commentaire ne fait jamais partie du texte.
comments-none-of-these = Aucun de ceux-ci.
comments-settle = Clore le fil
comments-reopen = Rouvrir le fil
comments-edit = Modifier
comments-edited = modifié
comments-someone = Quelqu’un
comments-note-deleted = La note a été supprimée
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Appuyez pour aller à l’élément ; appuyez deux fois pour y écrire
comments-mark = { $count ->
    [one] Un commentaire ouvert
    [many] { $count } commentaires ouverts
   *[other] { $count } commentaires ouverts
}
comments-show-cards = Afficher chaque commentaire sous son élément
comments-mark-hint = { $count ->
    [one] Un commentaire ouvert : appuyez pour l’afficher sous l’élément, ou le cacher
    [many] { $count } commentaires ouverts : appuyez pour les afficher sous l’élément, ou les cacher
   *[other] { $count } commentaires ouverts : appuyez pour les afficher sous l’élément, ou les cacher
}
