# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = un @string sans nom
core-bib-expected-found = `{ $expected }` était attendu, mais `{ $found }` a été trouvé
core-bib-expected-end = `{ $expected }` était attendu, mais le fichier s’arrête là
core-bib-expected-brace = `@{ $kind }` n’est suivi ni de `{"{"}` ni de `(`
core-bib-comment-not-closed = un commentaire qui n’est jamais fermé
core-bib-entry-not-closed = l’entrée `{ $key }` n’est jamais fermée
core-bib-expected-field = dans `{ $key }` : un nom de champ était attendu, mais `{ $found }` a été trouvé
core-bib-field-without-value = dans `{ $key }` : le champ `{ $field }` n’a pas de valeur
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = dans `{ $key }`, champ `{ $field }` : { $message }
core-bib-brace-not-closed = une accolade qui n’est jamais fermée
core-bib-quote-not-closed = un guillemet qui n’est jamais fermé
core-bib-expected-value = une valeur était attendue, mais `{ $found }` a été trouvé
core-bib-abbreviation = l’abréviation `{ $name }` n’est pas définie
core-bib-ended-in-value = le fichier s’arrête au milieu d’une valeur
