# The kinds of elements that make a document, which come with the
# application (ADR 0038): what each is called in the kind menu and on the
# label of an element. The core has the same kinds, with their looks.

parts-group-front = Pages liminaires
parts-group-back = Pages finales
parts-group-cover = Couverture
parts-more = Autres…

# The bases.
parts-front-section = Section liminaire
parts-back-section = Section finale
parts-own-page = Page à part
parts-cover = Couverture

# Front matter.
parts-abstract = Résumé
parts-dedication = Dédicace
parts-epigraph = Épigraphe
parts-copyright = Page de copyright
parts-foreword = Préface
parts-preface = Avant-propos
parts-cast = Personnages
parts-setting = Lieu de l’action
parts-standfirst = Chapeau

# Back matter.
parts-acknowledgements = Remerciements
parts-appendix = Annexe
parts-afterword = Postface
parts-glossary = Glossaire
parts-about-the-author = À propos de l’auteur
parts-signature = Signature

# The cover.
parts-blurb = Quatrième de couverture

# On the label of a second element of a kind a document has one of.
parts-doubled = Pas imprimé : un autre élément de ce type le précède au même niveau.

## Where a kind puts an element in the document, where not where it stands.

parts-placed-front = Imprimé au début, avant le reste de son niveau
parts-placed-back = Imprimé à la fin, après le reste de son niveau
parts-placed-cover = Imprimé sur la couverture seulement
parts-placed-none = Pas imprimé dans le document
parts-placed-front-short = imprimé au début
parts-placed-back-short = imprimé à la fin
parts-placed-cover-short = sur la couverture seulement
parts-placed-none-short = pas imprimé
