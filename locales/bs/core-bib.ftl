# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = @string bez imena
core-bib-expected-found = očekivano `{ $expected }`, a pronađeno `{ $found }`
core-bib-expected-end = očekivano `{ $expected }`, a datoteka se završila
core-bib-expected-brace = iza `@{ $kind }` ne slijedi `{"{"}` ni `(`
core-bib-comment-not-closed = komentar koji se nikad ne zatvara
core-bib-entry-not-closed = unos `{ $key }` se nikad ne zatvara
core-bib-expected-field = u `{ $key }`: očekivan naziv polja, a pronađeno `{ $found }`
core-bib-field-without-value = u `{ $key }`: polje `{ $field }` nema vrijednost
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = u `{ $key }`, polje `{ $field }`: { $message }
core-bib-brace-not-closed = vitičasta zagrada koja se nikad ne zatvara
core-bib-quote-not-closed = navodnik koji se nikad ne zatvara
core-bib-expected-value = očekivana vrijednost, a pronađeno `{ $found }`
core-bib-abbreviation = skraćenica `{ $name }` nije definirana
core-bib-ended-in-value = datoteka se završila usred vrijednosti
