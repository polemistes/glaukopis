# What the core says of spelling, in English. See locales/README.md.

# $name is the name of the dictionary's files: nb_NO. $message says why.
spelling-unreadable = Rječnik { $name } nije bilo moguće pročitati: { $message }
spelling-encoding = Rječnik { $name } zapisan je u kodiranju koje se ne može pročitati.
# Stands after "not found:". $language is the language of a map: nb, en-GB.
spelling-dictionary-for = rječnik za „{ $language }“
spelling-not-a-word = „{ $word }“ se ne može dodati vašim riječima.
spelling-not-a-language = Vlastite riječi ne mogu se čuvati za „{ $language }“.
