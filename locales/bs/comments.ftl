# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Komentari
comments-between = Između mape i komentara
comments-comment-on = Komentiraj…
comments-comment = Komentiraj
comments-write = Napišite komentar. Enter ga šalje, a Shift+Enter prelazi u novi red.
# $name: the element the comment is on.
comments-on = Uz „{ $name }“
comments-answer = Odgovori…
comments-which = Koji se komentari prikazuju
comments-open = { $count ->
    [0] Otvoreni
   *[other] Otvoreni ({ $count })
}
comments-settled = { $count ->
    [0] Riješeni
   *[other] Riješeni ({ $count })
}
comments-all = Svi
comments-none = Još nema komentara
comments-none-detail = Odaberite dio teksta i pritisnite Ctrl+Alt+C ili izaberite Komentiraj… iz menija elementa. Komentar nikad nije dio teksta.
comments-none-of-these = Nijedan od ovih.
comments-settle = Riješi nit
comments-reopen = Ponovo otvori nit
comments-edit = Izmijeni
comments-edited = izmijenjeno
comments-someone = Neko
comments-note-deleted = Bilješka je izbrisana
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Pritisnite da odete na element; pritisnite dvaput da pišete u njemu
comments-mark = { $count ->
    [one] Jedan otvoreni komentar
    [few] { $count } otvorena komentara
   *[other] { $count } otvorenih komentara
}
comments-show-cards = Prikaži svaki komentar pod njegovim elementom
comments-mark-hint = { $count ->
    [one] Jedan otvoreni komentar: pritisnite da ga prikažete pod elementom ili sakrijete
    [few] { $count } otvorena komentara: pritisnite da ih prikažete pod elementom ili sakrijete
   *[other] { $count } otvorenih komentara: pritisnite da ih prikažete pod elementom ili sakrijete
}
