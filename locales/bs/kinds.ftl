   *[other] { $count } elemenata
}
kinds-delete-title = Izbrisati vrstu „{ $name }“?
kinds-delete-message = { $count ->
    [0] Nijedan element nije te vrste.
    [one] Jedini element koji je te vrste neće biti nijedne vrste.
    [few] { $count } elementa koja su te vrste neće biti nijedne vrste.
   *[other] { $count } elemenata koji su te vrste neće biti nijedne vrste.
}
