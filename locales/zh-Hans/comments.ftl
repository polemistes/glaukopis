# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = 批注
comments-between = 导图与批注之间
comments-comment-on = 批注…
comments-comment = 批注
comments-write = 写一条批注。按 Enter 发送，按 Shift+Enter 换行。
# $name: the element the comment is on.
comments-on = 关于“{ $name }”
comments-answer = 回复…
comments-which = 显示哪些批注
comments-open = { $count ->
    [0] 未解决
   *[other] 未解决（{ $count }）
}
comments-settled = { $count ->
    [0] 已解决
   *[other] 已解决（{ $count }）
}
comments-all = 全部
comments-none = 还没有批注
comments-none-detail = 选中一段文字后按 Ctrl+Alt+C，或在元素的菜单中选择“批注…”。批注永远不属于文本。
comments-none-of-these = 这里没有。
comments-settle = 解决此批注串
comments-reopen = 重新打开此批注串
comments-edit = 修改
comments-edited = 已修改
comments-someone = 某人
comments-note-deleted = 此条回复已删除
# On an element in the diagram, and in the margin of the text.
comments-element-hint = 单击转到该元素；单击两次在其中书写
comments-mark = { $count ->
   *[other] { $count } 条未解决的批注
}
comments-show-cards = 在每个元素下显示其所有批注
comments-mark-hint = { $count ->
   *[other] { $count } 条未解决的批注：单击在元素下显示或隐藏
}
