# The kinds of elements that make a document, which come with the
# application (ADR 0038): what each is called in the kind menu and on the
# label of an element. The core has the same kinds, with their looks.

parts-group-front = Indledende dele
parts-group-back = Afsluttende dele
parts-group-cover = Omslag
parts-more = Mere…

# The bases.
parts-front-section = Indledende afsnit
parts-back-section = Afsluttende afsnit
parts-own-page = Side for sig
parts-cover = Omslag

# Front matter.
parts-abstract = Resumé
parts-dedication = Dedikation
parts-epigraph = Epigraf
parts-copyright = Kolofon
parts-foreword = Forord
parts-preface = Fortale
parts-cast = Personliste
parts-setting = Sted og tid
parts-standfirst = Manchet

# Back matter.
parts-acknowledgements = Tak
parts-appendix = Bilag
parts-afterword = Efterord
parts-glossary = Ordliste
parts-about-the-author = Om forfatteren
parts-signature = Underskrift

# The cover.
parts-blurb = Bagsidetekst

# On the label of a second element of a kind a document has one of.
parts-doubled = Udskrives ikke: et andet element af denne art kommer først blandt dets søskende.

## Where a kind puts an element in the document, where not where it stands.

parts-placed-front = Udskrives forrest, før resten på samme niveau
parts-placed-back = Udskrives bagest, efter resten på samme niveau
parts-placed-cover = Udskrives kun på omslaget
parts-placed-none = Udskrives ikke i dokumentet
parts-placed-front-short = udskrives forrest
parts-placed-back-short = udskrives bagest
parts-placed-cover-short = kun på omslaget
parts-placed-none-short = udskrives ikke
