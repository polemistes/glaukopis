# What the core says of the store of pictures, in English.
# See locales/README.md.

core-pictures-not-a-picture = filen er ikke et billede af en type, der kan bruges: PNG, JPEG, SVG, GIF, WebP, TIFF eller BMP
core-pictures-unreadable = billedet kunne ikke læses: { $error }
core-pictures-not-as-asked = det, der kom, er ikke det billede, der blev bedt om
core-pictures-too-large = billedet er større end { $most } MB, som er det største, et billede må være
core-pictures-not-whole = billedet kom ikke helt frem
# Shown after "not found: ".
core-pictures-the-picture = billedet
# What a picture that came without a name is called, before the ending of
# its file: "picture.png".
core-pictures-unnamed = billede

# A simple image editor (docs/plans/a-simple-image-editor.md).
# Put before the ending of a copy's name: "plate (edited).jpg", "plate (edited 2).jpg".
core-pictures-edited = redigeret
# Likewise: "plate (smaller).jpg".
core-pictures-smaller = mindre
core-pictures-not-editable = en tegning har ingen pixel at redigere
core-pictures-nothing-changed = intet blev ændret
