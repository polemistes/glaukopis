# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = en @string uden navn
core-bib-expected-found = ventede `{ $expected }`, men fandt `{ $found }`
core-bib-expected-end = ventede `{ $expected }`, men filen sluttede
core-bib-expected-brace = `@{ $kind }` efterfølges ikke af `{"{"}` eller `(`
core-bib-comment-not-closed = en kommentar, der aldrig lukkes
core-bib-entry-not-closed = posten `{ $key }` lukkes aldrig
core-bib-expected-field = i `{ $key }`: ventede et feltnavn, men fandt `{ $found }`
core-bib-field-without-value = i `{ $key }`: feltet `{ $field }` har ingen værdi
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = i `{ $key }`, feltet `{ $field }`: { $message }
core-bib-brace-not-closed = en tuborgklamme, der aldrig lukkes
core-bib-quote-not-closed = et anførselstegn, der aldrig lukkes
core-bib-expected-value = ventede en værdi, men fandt `{ $found }`
core-bib-abbreviation = forkortelsen `{ $name }` er ikke defineret
core-bib-ended-in-value = filen sluttede midt i en værdi
