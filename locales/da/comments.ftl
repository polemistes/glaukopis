# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Kommentarer
comments-between = Mellem kortet og kommentarerne
comments-comment-on = Kommenter…
comments-comment = Kommenter
comments-write = Skriv en kommentar. Enter sender den; Skift+Enter giver en ny linje.
# $name: the element the comment is on.
comments-on = Til »{ $name }«
comments-answer = Svar…
comments-which = Hvilke kommentarer der vises
comments-open = { $count ->
    [0] Åbne
   *[other] Åbne ({ $count })
}
comments-settled = { $count ->
    [0] Afsluttede
   *[other] Afsluttede ({ $count })
}
comments-all = Alle
comments-none = Ingen kommentarer endnu
comments-none-detail = Markér noget tekst og tryk Ctrl+Alt+C, eller vælg Kommenter… i et elements menu. En kommentar er aldrig en del af teksten.
comments-none-of-these = Ingen af disse.
comments-settle = Afslut tråden
comments-reopen = Åbn tråden igen
comments-edit = Ændr
comments-edited = ændret
comments-someone = Nogen
comments-note-deleted = Indlægget blev slettet
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Tryk for at gå til elementet; tryk to gange for at skrive i det
comments-mark = { $count ->
    [one] Én åben kommentar
   *[other] { $count } åbne kommentarer
}
comments-show-cards = Vis hver kommentar under sit element
comments-mark-hint = { $count ->
    [one] Én åben kommentar: tryk for at vise den under elementet, eller skjule den
   *[other] { $count } åbne kommentarer: tryk for at vise dem under elementet, eller skjule dem
}
