# What the core says of the notebook, in English.
# See locales/README.md.

core-notebook-reading = læser notesbogen
core-notebook-picture-too-large = et billede, der blev givet til notesbogen, er større end { $most } MB
# Of a note written in a window of its own (record 0109).
core-notebook-note-empty = et tomt notat sendes ikke
core-notebook-note-too-large = notatets tekst er større end { $most } MB
core-notebook-file-too-large = { $name } er større end { $most } MB
# What was handed over by another app on a phone held neither words nor files; said after other words, so it begins with a small letter.
core-notebook-shared-empty = intet blev delt
# A file another app handed over could not be read from it; $name is what the other app calls the file.
core-notebook-shared-unread = { $name } kunne ikke læses
