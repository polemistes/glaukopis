# What the core says of project files (ADR 0036), in English.
# See locales/README.md.

core-projectfile-not-one = Dette er ikke en projektfil fra Glaukopis.
# $format is a number: the form of the file, which this version does not know.
core-projectfile-later = Denne projektfil er skrevet af en nyere version af Glaukopis (form { $format }). Opdater Glaukopis for at åbne den.
core-projectfile-no-document = Projektfilen indeholder intet projekt.
core-projectfile-unreadable = Projektfilen kan ikke læses: { $error }
core-projectfile-unwritable = Projektfilen kunne ikke skrives: { $error }
# $name is the name of a part of the file.
core-projectfile-too-large = En del af projektfilen er for stor: { $name }
# What the file says of its pictures could not be read; $cause is what was wrong.
core-projectfile-pictures-unreadable = Det, projektfilen siger om sine billeder, kunne ikke læses, så de kommer uden deres navne, billedtekster og beskrivelser: { $cause }

## What was being done when the system said no, shown before what it said.

core-projectfile-reading = kunne ikke læse projektfilen
