# A map as a diagram: the elements on a canvas, their branches and associations.

diagram-map = Mapa
diagram-idea = Názov
diagram-show-all = Zobraziť celú mapu
diagram-tidy = Upratať celú mapu
# The keys are shown as keys, where the variables stand.
diagram-hint-linking = Kliknite na prvok, s ktorým sa má spojiť, alebo naň prejdite šípkami a stlačte { $enter } · { $esc } to ukončí
diagram-link-handle = Potiahnite na iný prvok, aby sa spojili

## The view

diagram-view = Zobrazenie
diagram-zoom-out = Oddialiť
diagram-zoom-in = Priblížiť
diagram-actual-size = Skutočná veľkosť
# How large the map is shown, in hundredths of its size.
diagram-zoom = { $percent } %

## Copying and pasting elements.

diagram-copied = { $count ->
    [one] Jeden prvok skopírovaný so všetkým pod ním
    [few] { $count } prvky skopírované so všetkým pod nimi
   *[other] { $count } prvkov skopírovaných so všetkým pod nimi
}
diagram-nothing-copied = Zatiaľ nie je nič skopírované
diagram-pasted-elsewhere = Čo bolo skopírované, je z iného projektu a sem sa to prilepiť nedá
