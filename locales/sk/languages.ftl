languages-project = Jazyk nových máp v tomto projekte
languages-project-hint = V čom sa píše mapa vytvorená v tomto projekte, pre všetkých, s ktorými je projekt zdieľaný. Mapa vytvorená z dokumentu si ponechá jazyk dokumentu. Každej mape možno hore dať iný.
# Where the project chooses none, the settings' language of new texts holds; it is named.
languages-project-settings = Ako v nastaveniach ({ $language })
