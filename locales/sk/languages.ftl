# The languages of a map and of a project: the dialog opened from the menu
# of a map (ADR 0020).

languages-menu = Jazyky…
languages-dialog = Jazyky
languages-dialog-subtitle = Jazyk tejto mapy a máp, ktoré prídu
languages-map = Jazyk tejto mapy
# What follows from the language of a map: the words its document prints in
# words of its own, the dictionary of its spelling, the quotation marks of a mention.
languages-map-hint = Určuje slová, ktoré jej dokument tlačí vlastnými slovami, ako „Poznámky“ a „Obrázok“; slovník, podľa ktorého sa kontroluje pravopis; a úvodzovky, v ktorých stojí zmienka.
