# What the core says of spelling, in English. See locales/README.md.

# $name is the name of the dictionary's files: nb_NO. $message says why.
spelling-unreadable = Slovník { $name } sa nepodarilo prečítať: { $message }
spelling-encoding = Slovník { $name } je zapísaný v kódovaní, ktoré sa nedá prečítať.
# Stands after "not found:". $language is the language of a map: nb, en-GB.
spelling-dictionary-for = slovník pre „{ $language }“
spelling-not-a-word = „{ $word }“ nemožno pridať k vašim slovám.
spelling-not-a-language = Vlastné slová nemožno uchovávať pre „{ $language }“.
