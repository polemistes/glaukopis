# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = @string bez názvu
core-bib-expected-found = očakávalo sa `{ $expected }`, ale našlo sa `{ $found }`
core-bib-expected-end = očakávalo sa `{ $expected }`, ale súbor sa skončil
core-bib-expected-brace = za `@{ $kind }` nenasleduje `{"{"}` ani `(`
core-bib-comment-not-closed = komentár, ktorý sa nikdy neuzavrie
core-bib-entry-not-closed = záznam `{ $key }` sa nikdy neuzavrie
core-bib-expected-field = v `{ $key }`: očakával sa názov poľa, ale našlo sa `{ $found }`
core-bib-field-without-value = v `{ $key }`: pole `{ $field }` nemá hodnotu
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = v `{ $key }`, pole `{ $field }`: { $message }
core-bib-brace-not-closed = zátvorka, ktorá sa nikdy neuzavrie
core-bib-quote-not-closed = úvodzovka, ktorá sa nikdy neuzavrie
core-bib-expected-value = očakávala sa hodnota, ale našlo sa `{ $found }`
core-bib-abbreviation = skratka `{ $name }` nie je definovaná
core-bib-ended-in-value = súbor sa skončil uprostred hodnoty
