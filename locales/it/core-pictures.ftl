# What the core says of the store of pictures, in English.
# See locales/README.md.

core-pictures-not-a-picture = il file non è un'immagine di un tipo che si possa usare: PNG, JPEG, SVG, GIF, WebP, TIFF o BMP
core-pictures-unreadable = l'immagine non si è potuta leggere: { $error }
core-pictures-not-a-name = questo non è il nome di un'immagine
core-pictures-not-as-asked = ciò che è arrivato non è l'immagine richiesta
core-pictures-needs-name = un'immagine deve chiamarsi in qualche modo
core-pictures-too-large = l'immagine è più grande di { $most } MB, il massimo che un'immagine può essere
core-pictures-not-whole = l'immagine non è arrivata intera
# Shown after "not found: ".
core-pictures-the-picture = l'immagine
# What a picture that came without a name is called, before the ending of
# its file: "picture.png".
core-pictures-unnamed = immagine
