# What the core says of the notebook, in English.
# See locales/README.md.

core-notebook-reading = lettura del taccuino
core-notebook-picture-too-large = un'immagine data al taccuino è più grande di { $most } MB
# Of a note written in a window of its own (record 0109).
core-notebook-note-empty = una nota vuota non si invia
core-notebook-note-too-large = il testo della nota è più grande di { $most } MB
core-notebook-file-too-large = { $name } è più grande di { $most } MB
# What was handed over by another app on a phone held neither words nor files; said after other words, so it begins with a small letter.
core-notebook-shared-empty = non è stato condiviso niente
# A file another app handed over could not be read from it; $name is what the other app calls the file.
core-notebook-shared-unread = { $name } non si è potuto leggere
