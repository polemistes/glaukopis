# A message of another that arrived: their name and its first words.
chat-said = { $name }: { $words }
chat-arrived = { $count ->
    [one] Un nuovo messaggio in { $project }
    [many] { $count } nuovi messaggi in { $project }
   *[other] { $count } nuovi messaggi in { $project }
}
chat-show = Mostra
