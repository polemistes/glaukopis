## How long ago something was: "Changed { $ago }".

time-just-now = proprio ora
time-minutes-ago = { $count ->
    [one] un minuto fa
    [many] { $count } minuti fa
   *[other] { $count } minuti fa
}
time-hours-ago = { $count ->
    [one] un'ora fa
    [many] { $count } ore fa
   *[other] { $count } ore fa
}
