# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Commenti
comments-between = Tra la mappa e i commenti
comments-comment-on = Commenta…
comments-comment = Commenta
comments-write = Scrivi un commento. Invio lo manda; Maiusc+Invio va a capo.
# $name: the element the comment is on.
comments-on = Su «{ $name }»
comments-answer = Rispondi…
comments-which = Quali commenti sono mostrati
comments-open = { $count ->
    [0] Aperti
   *[other] Aperti ({ $count })
}
comments-settled = { $count ->
    [0] Chiusi
   *[other] Chiusi ({ $count })
}
comments-all = Tutti
comments-none = Ancora nessun commento
comments-none-detail = Seleziona del testo e premi Ctrl+Alt+C, oppure scegli Commenta… dal menu di un elemento. Un commento non fa mai parte del testo.
comments-none-of-these = Nessuno di questi.
comments-settle = Chiudi la discussione
comments-reopen = Riapri la discussione
comments-edit = Modifica
comments-edited = modificato
comments-someone = Qualcuno
comments-note-deleted = La nota è stata eliminata
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Premi per andare all'elemento; premi due volte per scriverci dentro
comments-mark = { $count ->
    [one] Un commento aperto
    [many] { $count } commenti aperti
   *[other] { $count } commenti aperti
}
comments-show-cards = Mostra ogni commento sotto il suo elemento
comments-mark-hint = { $count ->
    [one] Un commento aperto: premi per mostrarlo sotto l'elemento, o per nasconderlo
    [many] { $count } commenti aperti: premi per mostrarli sotto l'elemento, o per nasconderli
   *[other] { $count } commenti aperti: premi per mostrarli sotto l'elemento, o per nasconderli
}
