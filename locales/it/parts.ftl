# The kinds of elements that make a document, which come with the
# application (ADR 0038): what each is called in the kind menu and on the
# label of an element. The core has the same kinds, with their looks.

parts-group-front = Parti iniziali
parts-group-back = Parti finali
parts-group-cover = Copertina
parts-more = Altro…

# The bases.
parts-front-section = Sezione iniziale
parts-back-section = Sezione finale
parts-own-page = Pagina a sé
parts-cover = Copertina

# Front matter.
parts-abstract = Abstract
parts-dedication = Dedica
parts-epigraph = Epigrafe
parts-copyright = Pagina del copyright
parts-foreword = Prefazione
parts-preface = Premessa
parts-cast = Personaggi
parts-setting = Ambientazione
parts-standfirst = Sommario

# Back matter.
parts-acknowledgements = Ringraziamenti
parts-appendix = Appendice
parts-afterword = Postfazione
parts-glossary = Glossario
parts-about-the-author = Nota sull'autore
parts-signature = Firma

# The cover.
parts-blurb = Quarta di copertina

# On the label of a second element of a kind a document has one of.
parts-doubled = Non stampato: un altro elemento di questo tipo viene prima, tra quelli accanto a esso.

## Where a kind puts an element in the document, where not where it stands.

parts-placed-front = Stampato all'inizio, prima del resto del suo livello
parts-placed-back = Stampato alla fine, dopo il resto del suo livello
parts-placed-cover = Stampato solo sulla copertina
parts-placed-none = Non stampato nel documento
parts-placed-front-short = stampato all'inizio
parts-placed-back-short = stampato alla fine
parts-placed-cover-short = solo sulla copertina
parts-placed-none-short = non stampato
