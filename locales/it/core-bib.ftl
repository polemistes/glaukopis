# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = una @string senza nome
core-bib-expected-found = atteso `{ $expected }`, trovato `{ $found }`
core-bib-expected-end = atteso `{ $expected }`, ma il file finisce
core-bib-expected-brace = `@{ $kind }` non è seguito da `{"{"}` o `(`
core-bib-comment-not-closed = un commento mai chiuso
core-bib-entry-not-closed = la voce `{ $key }` non è mai chiusa
core-bib-expected-field = in `{ $key }`: atteso il nome di un campo, trovato `{ $found }`
core-bib-field-without-value = in `{ $key }`: il campo `{ $field }` non ha valore
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = in `{ $key }`, campo `{ $field }`: { $message }
core-bib-brace-not-closed = una graffa mai chiusa
core-bib-quote-not-closed = virgolette mai chiuse
core-bib-expected-value = atteso un valore, trovato `{ $found }`
core-bib-abbreviation = l'abbreviazione `{ $name }` non è definita
core-bib-ended-in-value = il file finisce a metà di un valore
