# Comments: threads of notes on an element, or on a passage of its text, at the side of a project.

comments-title = Komentarji
comments-between = Med miselnim vzorcem in komentarji
comments-comment-on = Komentiraj…
comments-comment = Komentiraj
comments-write = Napišite komentar. Enter ga pošlje, Shift+Enter začne novo vrstico.
# $name: the element the comment is on.
comments-on = K »{ $name }«
comments-answer = Odgovori…
comments-which = Kateri komentarji so prikazani
comments-open = { $count ->
    [0] Odprti
   *[other] Odprti ({ $count })
}
comments-settled = { $count ->
    [0] Razrešeni
   *[other] Razrešeni ({ $count })
}
comments-all = Vsi
comments-none = Še ni komentarjev
comments-none-detail = Izberite besedilo in pritisnite Ctrl+Alt+C ali pa v meniju elementa izberite »Komentiraj…«. Komentar ni nikoli del besedila.
comments-none-of-these = Nobeden od teh.
comments-settle = Razreši nit
comments-reopen = Znova odpri nit
comments-edit = Spremeni
comments-edited = spremenjeno
comments-someone = Nekdo
comments-note-deleted = Zapis je bil izbrisan
# On an element in the diagram, and in the margin of the text.
comments-element-hint = Pritisnite, da greste na element; pritisnite dvakrat, da pišete vanj
comments-mark = { $count ->
    [one] { $count } odprt komentar
    [two] { $count } odprta komentarja
    [few] { $count } odprti komentarji
   *[other] { $count } odprtih komentarjev
}
comments-show-cards = Pokaži vsak komentar pod njegovim elementom
comments-mark-hint = { $count ->
    [one] { $count } odprt komentar: pritisnite, da ga pokažete pod elementom ali skrijete
    [two] { $count } odprta komentarja: pritisnite, da ju pokažete pod elementom ali skrijete
    [few] { $count } odprti komentarji: pritisnite, da jih pokažete pod elementom ali skrijete
   *[other] { $count } odprtih komentarjev: pritisnite, da jih pokažete pod elementom ali skrijete
}
