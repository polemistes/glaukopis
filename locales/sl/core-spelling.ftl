# What the core says of spelling, in English. See locales/README.md.

# $name is the name of the dictionary's files: nb_NO. $message says why.
spelling-unreadable = Slovarja { $name } ni bilo mogoče prebrati: { $message }
spelling-encoding = Slovar { $name } je zapisan v kodiranju, ki ga ni mogoče prebrati.
# Stands after "not found:". $language is the language of a map: nb, en-GB.
spelling-dictionary-for = slovar za »{ $language }«
spelling-not-a-word = »{ $word }« ni mogoče dodati med vaše besede.
spelling-not-a-language = Lastnih besed za »{ $language }« ni mogoče hraniti.
