# A map as a diagram: the elements on a canvas, their branches and associations.

diagram-map = Miselni vzorec
diagram-idea = Ime
diagram-new-loose = Nov prost element tukaj
diagram-new-loose-hint = Misel, ki še nima svojega mesta
diagram-show-all = Pokaži ves miselni vzorec
diagram-tidy = Uredi ves miselni vzorec
diagram-tidy-hint = Vsak element se vrne na svoje samodejno mesto
# The keys are shown as keys, where the variables stand.
diagram-hint-empty = { $tab } doda element pod izbranega · { $enter } doda element ob njem · dvoklik za pisanje
diagram-hint-linking = Kliknite element, s katerim ga želite povezati, ali pojdite nanj s smernimi tipkami in pritisnite { $enter } · { $esc } za izhod
diagram-show-under = Pokaži, kar je pod njim
diagram-hide-under = Skrij, kar je pod njim
diagram-link-handle = Povlecite do drugega elementa, da ju povežete

## The view

diagram-view = Pogled
diagram-zoom-out = Pomanjšaj
diagram-zoom-in = Povečaj
diagram-actual-size = Dejanska velikost
# How large the map is shown, in hundredths of its size.
diagram-zoom = { $percent } %

## Copying and pasting elements.

diagram-copied = { $count ->
    [one] { $count } element kopiran z vsem, kar je pod njim
    [two] { $count } elementa kopirana z vsem, kar je pod njima
    [few] { $count } elementi kopirani z vsem, kar je pod njimi
   *[other] { $count } elementov kopiranih z vsem, kar je pod njimi
}
diagram-nothing-copied = Nič še ni kopirano
diagram-pasted-elsewhere = Kopirano je iz drugega projekta in ga tu ni mogoče prilepiti
