# What the core says of faults in a file of BibTeX or BibLaTeX, in English.
# They are shown after the line they are on. See locales/README.md.

core-bib-string-without-name = @string brez imena
core-bib-expected-found = pričakovano `{ $expected }`, najdeno pa `{ $found }`
core-bib-expected-end = pričakovano `{ $expected }`, a se je datoteka končala
core-bib-expected-brace = za `@{ $kind }` ne stoji `{"{"}` ali `(`
core-bib-comment-not-closed = komentar, ki ni nikoli zaključen
core-bib-entry-not-closed = vnos `{ $key }` ni nikoli zaključen
core-bib-expected-field = v `{ $key }`: pričakovano ime polja, najdeno pa `{ $found }`
core-bib-field-without-value = v `{ $key }`: polje `{ $field }` nima vrednosti
# Where in an entry a fault is, before the fault itself.
core-bib-in-field = v `{ $key }`, polje `{ $field }`: { $message }
core-bib-brace-not-closed = oklepaj, ki ni nikoli zaprt
core-bib-quote-not-closed = narekovaj, ki ni nikoli zaprt
core-bib-expected-value = pričakovana vrednost, najdeno pa `{ $found }`
core-bib-abbreviation = okrajšava `{ $name }` ni določena
core-bib-ended-in-value = datoteka se je končala sredi vrednosti
