{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glaukopis",
  "version": "0.2.2",
  "identifier": "org.glaukopis.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Glaukopis",
        "width": 1360,
        "height": 880,
        "minWidth": 480,
        "minHeight": 400,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws: wss:",
      "assetProtocol": { "enable": false }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Education",
    "shortDescription": "Writing, from ideas to the finished text",
    "longDescription": "Glaukopis is where a text of any kind is written: ideas developed in mind maps, references collected, the text written into the map, and the finished document made in the form it is to be published in.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": { "../resources": "resources" },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "linux": {
      "deb": {
        "recommends": ["tesseract-ocr", "tesseract-ocr-eng", "poppler-utils", "librsvg2-bin", "hunspell-en-us", "hunspell-en-gb", "fonts-noto-core", "fonts-noto-cjk"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "openssl-libs"],
        "recommends": ["tesseract", "tesseract-langpack-eng", "poppler-utils", "librsvg2-tools", "hunspell-en-US", "hunspell-en-GB", "google-noto-sans-cjk-fonts"]
      }
    }
  }
}
