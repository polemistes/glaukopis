<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The phone's camera app, which takes a photograph for a note: since
         Android 11 an app must say which others it means to ask, or it is
         told there are none, and the web view then shows the picker of
         pictures instead. The camera app asks for nothing on this app's
         behalf: there is no permission for the camera here. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- Nothing of the app is carried to Google's backup, or to another
         phone by the system: what is written goes to the writer's own
         server and nowhere else. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.glaukopis_phone"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- One way in: whatever starts the app enters here, which looks
             whether the device has a web view the page can run in before
             anything of Glaukopis is loaded, and then starts the page.
             It has a task of no affinity, kept out of the recent apps,
             which goes when it ends: in the page's task it would stay
             that task's first intent, and Android takes a second share
             or New note equal to it in all but its words as asking only
             for the task to be brought to the front, and starts nothing
             (found on the emulator). -->
        <activity
            android:name=".StartActivity"
            android:label="@string/main_activity_title"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Share from another app: words, an address, pictures and files. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- Glaukopis in the menu over words selected in another app, by this activity's label. -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- New note, on the icon held down. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <!-- The page, started by the app alone. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="false" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
